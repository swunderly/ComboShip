+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <string>
+#include <utility>
+
+namespace ComboRando {
+// 0 is deliberately unknown: old saves merged physical previews and hints.
+// Those records must never be retroactively advertised as a physical sighting.
+struct TrackerKnowledge {
+    uint8_t source = 0; // 1 = rendered observation, 2 = explicit item hint
+    int32_t item = 0;
+    std::string displayName;
+};
+
+inline bool RecordTrackerKnowledge(TrackerKnowledge& previous, uint8_t source, int32_t item,
+                                   std::string displayName) {
+    if ((source != 1 && source != 2) || item <= 0 || displayName.empty()) return false;
+    // Hints describe the seed item, sometimes only its progressive family.
+    // Never replace the exact tier/disguise the player has already looked at.
+    if (source == 2 && previous.source == 1) return false;
+    if (previous.source == source && previous.item == item && previous.displayName == displayName) return false;
+    previous = {source, item, std::move(displayName)};
+    return true;
+}
+
+// A submitted draw is insufficient: generous actor culling boxes extend off
+// screen. Test the rendered model origin against the actual camera frustum.
+inline bool TrackerItemInView(float x, float y, float z, float w, float horizontalScale,
+                              float scaleX2, float scaleY2, float scaleZ2, bool viewCovered) {
+    return !viewCovered && std::isfinite(w) && std::isfinite(x) && std::isfinite(y) && std::isfinite(z) &&
+        std::isfinite(horizontalScale) && w > 0 && horizontalScale > 0 &&
+        scaleX2 >= 0.000001f && scaleY2 >= 0.000001f && scaleZ2 >= 0.000001f &&
+        z >= -w && z <= w && std::fabs(x) <= w * horizontalScale && std::fabs(y) <= w;
+}
+}
