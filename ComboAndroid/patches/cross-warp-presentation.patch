+static void SetSelection(PlayState* play, int owl) {
+    PauseContext* pauseCtx=&play->pauseCtx;
+    pauseCtx->cursorPoint[PAUSE_WORLD_MAP]=owl;
+    pauseCtx->namedItem=owl; pauseCtx->nameDisplayTimer=0;
+    pauseCtx->nameSegment=(void*)sOwlNames[owl];
+    sCursorShrinkRate=4;
+}
+int Combo_SOHSoaringMapActive(void) { return sMapPlay!=NULL; }
+int Combo_SOHSoaringMapBegin(PlayState* play, uint32_t choices) {
+    if(sMapPlay || !(choices&0xffc0) || !Combo_SOHPrepareWarpAssets()) return 0;
+    sSavedPause=play->pauseCtx; sMapPlay=play; sChoices=choices;
+    play->pauseCtx.state=PAUSE_STATE_OWLWARP_3;
+    play->pauseCtx.eye=(Vec3f){-64,0,0};
+    play->pauseCtx.alpha=0; play->pauseCtx.infoPanelOffsetY=-80;
+    play->pauseCtx.cursorSpecialPos=0; play->pauseCtx.unk_1E4=0;
+    play->pauseCtx.cursorColorSet=4; play->pauseCtx.nameColorSet=0;
+    for(int owl=0;owl<10;owl++) play->pauseCtx.worldMapPoints[owl]=(choices>>(owl+6))&1;
+    for(int owl=0;owl<10;owl++) if(choices&(1u<<(owl+6))) { SetSelection(play,owl); break; }
+    sStick=0; sRepeat=0; sMapPageRoll=320; sMapVerticalOffset=-6240;
+    sMapTick=0; sMapReply=-1; R_PAUSE_OWLWARP_ALPHA=0;
+    sSavedHud=gSaveContext.hudVisibilityMode;
+    Message_CloseTextbox(play);
+    Interface_SetDoAction(play, DO_ACTION_DECIDE);
+    Interface_LoadActionLabelB(play, DO_ACTION_STOP);
+    return 1;
+}
+void Combo_SOHSoaringMapClose(PlayState* play) {
+    if(sMapPlay!=play) return;
+    play->pauseCtx=sSavedPause; sMapPlay=NULL;
+    Interface_SetDoAction(play, DO_ACTION_NONE);
+    Interface_ChangeHudVisibilityMode(sSavedHud);
+}
+void Combo_SOHSoaringMapFinish(PlayState* play, int reply) {
+    if(sMapPlay!=play || play->pauseCtx.state==PAUSE_STATE_OWLWARP_6) return;
+    sMapReply=reply; sMapTick=0; sMapVerticalOffset=-6240;
+    play->pauseCtx.state=PAUSE_STATE_OWLWARP_6;
+    Message_CloseTextbox(play);
+}
+int Combo_SOHSoaringMapUpdate(PlayState* play) {
+    if(sMapPlay!=play) return 0;
+    if(play->pauseCtx.state==PAUSE_STATE_OWLWARP_3 || play->pauseCtx.state==PAUSE_STATE_OWLWARP_6) {
+        // Keep MM's 30 Hz roll/fade steps when drawn in OoT's 20 Hz world.
+        sMapTick+=3;
+        while(sMapTick>=2) {
+            sMapTick-=2;
+            if(play->pauseCtx.state==PAUSE_STATE_OWLWARP_3) {
+                sMapPageRoll-=40;
+                play->pauseCtx.alpha=MIN(play->pauseCtx.alpha+31,255);
+                play->pauseCtx.infoPanelOffsetY+=10;
+                R_PAUSE_OWLWARP_ALPHA=MIN(R_PAUSE_OWLWARP_ALPHA+20,120);
+                if(sMapPageRoll<=0) {
+                    sMapPageRoll=0; sMapVerticalOffset=0;
+                    play->pauseCtx.alpha=255; play->pauseCtx.infoPanelOffsetY=0;
+                    play->pauseCtx.state=PAUSE_STATE_OWLWARP_SELECT;
+                    break;
+                }
+            } else {
+                sMapPageRoll+=40;
+                play->pauseCtx.alpha=MAX(play->pauseCtx.alpha-63,0);
+                play->pauseCtx.infoPanelOffsetY-=10;
+                R_PAUSE_OWLWARP_ALPHA=MAX(R_PAUSE_OWLWARP_ALPHA-60,0);
+                if(sMapPageRoll>=160) {
+                    int reply=sMapReply;
+                    Combo_SOHSoaringMapClose(play);
+                    SOH_ForeignSongChoose(reply);
+                    break;
+                }
+            }
+        }
+        return 1;
+    }
+    if(play->pauseCtx.state==PAUSE_STATE_OWLWARP_CONFIRM) { Message_Update(play); return 1; }
+    Input* input=&play->state.input[0];
+    if(input->press.button&(BTN_B|BTN_START)) { SOH_ForeignSongChoose(-1); return 1; }
+    if(input->press.button&BTN_A) {
+        input->press.button &= ~BTN_A;
+        Audio_PlaySoundGeneral(NA_SE_SY_DECIDE,&gSfxDefaultPos,4,&gSfxDefaultFreqAndVolScale,
+            &gSfxDefaultFreqAndVolScale,&gSfxDefaultReverb);
+        Combo_SOHMapConfirm(play->pauseCtx.cursorPoint[PAUSE_WORLD_MAP]+6);
+        play->pauseCtx.state=PAUSE_STATE_OWLWARP_CONFIRM;
+        return 1;
+    }
+    int stick=input->cur.stick_x>30 ? 1 : input->cur.stick_x< -30 ? -1 : 0;
+    int direction=(input->press.button&BTN_DRIGHT) ? 1 : (input->press.button&BTN_DLEFT) ? -1 : 0;
+    if(stick) { if(stick!=sStick || --sRepeat<=0) {direction=stick; sRepeat=stick!=sStick ? 10 : 3;} }
+    sStick=stick;
+    if(direction) {
+        int current=play->pauseCtx.cursorPoint[PAUSE_WORLD_MAP];
+        for(int step=1;step<=10;step++) {
+            int owl=(current+direction*step+10)%10;
+            if(sChoices&(1u<<(owl+6))) { SetSelection(play,owl); break; }
+        }
+        Audio_PlaySoundGeneral(NA_SE_SY_CURSOR,&gSfxDefaultPos,4,&gSfxDefaultFreqAndVolScale,
+            &gSfxDefaultFreqAndVolScale,&gSfxDefaultReverb);
+    }
+    return 1;
+}
+int Combo_SOHSoaringMapDraw(PlayState* play) {
+    if(sMapPlay!=play) return 0;
+    OPEN_DISPS(play->state.gfxCtx);
+    gSPComboRMPush(POLY_OPA_DISP++, "mm-warp");
+    KaleidoScope_SetView(&play->pauseCtx,-64,0,0);
+    KaleidoScope_SetVertices(play,play->state.gfxCtx);
+    Gfx_SetupDL_42Opa(play->state.gfxCtx);
+    gDPSetCombineLERP(POLY_OPA_DISP++,TEXEL0,0,PRIMITIVE,0,TEXEL0,0,SHADE,0,TEXEL0,0,PRIMITIVE,0,TEXEL0,0,SHADE,0);
+    gDPSetPrimColor(POLY_OPA_DISP++,0,0,180,180,120,255);
+    Matrix_RotateY(-1.57f,MTXMODE_NEW);
+    Matrix_Translate(0,sMapVerticalOffset/100,-93,MTXMODE_APPLY);
+    Matrix_Scale(.78f,.78f,.78f,MTXMODE_APPLY);
+    Matrix_RotateX(-sMapPageRoll/100,MTXMODE_APPLY);
+    gSPMatrix(POLY_OPA_DISP++,MATRIX_NEWMTX(play->state.gfxCtx),G_MTX_NOPUSH|G_MTX_LOAD|G_MTX_MODELVIEW);
+    POLY_OPA_DISP=KaleidoScope_DrawPageSections(POLY_OPA_DISP,play->pauseCtx.mapPageVtx,sMapPageBgTextures);
+    Matrix_RotateY(-1.57f,MTXMODE_NEW);
+    Matrix_Translate(0,(play->pauseCtx.state==PAUSE_STATE_OWLWARP_3 ||
+        play->pauseCtx.state==PAUSE_STATE_OWLWARP_6) ? -80.9f : -.9f,-144,MTXMODE_APPLY);
+    Matrix_RotateX(-sMapPageRoll/100,MTXMODE_APPLY);
+    gSPMatrix(POLY_OPA_DISP++,MATRIX_NEWMTX(play->state.gfxCtx),G_MTX_NOPUSH|G_MTX_LOAD|G_MTX_MODELVIEW);
+    KaleidoScope_DrawWorldMap(play);
+    Gfx_SetupDL_42Opa(play->state.gfxCtx);
+    KaleidoScope_SetView(&play->pauseCtx,0,0,64);
+    KaleidoScope_DrawOwlWarpInfoPanel(play); KaleidoScope_UpdateCursorSize(play);
+    if(play->pauseCtx.state==PAUSE_STATE_OWLWARP_SELECT) KaleidoScope_DrawCursor(play);
+    gSPComboRMPop(POLY_OPA_DISP++);
+    CLOSE_DISPS(play->state.gfxCtx);
+    return 1;
+}
+
+#endif
diff --git a/soh/soh/Enhancements/CrossWarp/CrossWarp.cpp b/soh/soh/Enhancements/CrossWarp/CrossWarp.cpp
new file mode 100644
--- /dev/null
+++ b/soh/soh/Enhancements/CrossWarp/CrossWarp.cpp
@@ -0,0 +1,77 @@
+#ifdef COMBO_BUILD
+#include "CrossWarp.h"
+#include "MMWarpAssets.h"
+#include "menu/ComboForeignAnim.h"
+#include "ComboResolve.h"
+#include <algorithm>
+extern "C" int Combo_SOHPrepareWarpAssets() {
+    auto ensure=(int(*)())Combo_ResolveSym("2ship","MM_EnsureWarpResources");
+    if(!ensure || !ensure()) return 0;
+    const char* required[]={gGameplayKeepKFSkel_85640,gGameplayKeepKFAnim_83534,
+        gSoaringWarpCsFeatherDL,gSoaringWarpCsWindCapsuleDL,gSoaringWarpCsWindCapsuleTexAnim,
+        gOceff6DL,gOceff6Vtx,ovl_Oceff_Wipe6_Matanimheader_000338,
+        gWorldMapImageTex,gWorldMapImageTLUT,gWorldMapOwlFaceTex,gItemNamePanelDL};
+    for(const char* path:required) if(!Combo_SOHWarpResource(path)) return 0;
+    return 1;
+}
+extern "C" void* Combo_SOHWarpResource(const char* path) {
+    auto load=(void*(*)(const char*))Combo_ResolveSym("2ship","MM_LoadWarpResource");
+    return load ? load(path) : nullptr;
+}
+extern "C" uint32_t Combo_SOHMapClouds() {
+    auto clouds=(uint32_t(*)())Combo_ResolveSym("2ship","MM_GetWarpMapClouds");
+    return clouds ? clouds() : 0;
+}
+extern "C" void Combo_SOHWarpMaterial(PlayState* play,const char* path,int step) {
+    auto* mat=(const CfaMatEntry*)Combo_SOHWarpResource(path);
+    if(!mat || !mat->segment) return;
+    for(int entry=0;entry<kMaxMatEntries;entry++,mat++) {
+        const int segment=std::abs(mat->segment)+7;
+        if(mat->type==kMatTypeTwoTexScroll && mat->params) {
+            CfaDrawTwoTexScroll(play,segment,(const CfaTexScrollEntry*)mat->params,step,false);
+        } else if(mat->type==2 || mat->type==3 || mat->type==4) {
+            auto* colors=(const CfaColorParams*)mat->params;
+            if(!colors || !colors->keyFrameLength || !colors->primColors) return;
+            if(mat->type==2) CfaDrawColorIndexed(play,segment,colors,step);
+            else {
+                if(!colors->keyFrames || colors->keyFrameCount<2 || colors->keyFrameCount>kMaxKeyFrames) return;
+                if(mat->type==4) CfaDrawColorLagrange(play,segment,colors,step);
+                else {
+                    // MM AnimatedMat_DrawColorLerp, retaining its integer color conversion.
+                    const int frame=step%colors->keyFrameLength;
+                    int upper=1;
+                    while(upper<colors->keyFrameCount-1 && frame>=colors->keyFrames[upper]) ++upper;
+                    const int length=colors->keyFrames[upper]-colors->keyFrames[upper-1];
+                    const float phase=length>0 ? std::clamp(float(frame-colors->keyFrames[upper-1])/length,0.0f,1.0f) : 0.0f;
+                    CfaPrimColor prim; CfaEnvColor env;
+                    auto lerp=[phase](uint8_t a,uint8_t b) {return uint8_t(a+(b-a)*phase);};
+                    const auto& a=colors->primColors[upper-1]; const auto& b=colors->primColors[upper];
+                    prim={lerp(a.r,b.r),lerp(a.g,b.g),lerp(a.b,b.b),lerp(a.a,b.a),lerp(a.lodFrac,b.lodFrac)};
+                    if(colors->envColors) {
+                        const auto& c=colors->envColors[upper-1]; const auto& d=colors->envColors[upper];
+                        env={lerp(c.r,d.r),lerp(c.g,d.g),lerp(c.b,d.b),lerp(c.a,d.a)};
+                    }
+                    CfaSetColorSegment(play,segment,&prim,colors->envColors ? &env : nullptr);
+                }
+            }
+        } else return;
+        if(mat->segment<0) break;
+    }
+}
+extern "C" void Combo_SOHRestoreWarpMaterial(PlayState* play,const char* path) {
+    auto* mat=(const CfaMatEntry*)Combo_SOHWarpResource(path);
+    if(!mat || !mat->segment) return;
+    int32_t segments[kMaxMatEntries],count=0;
+    do { segments[count++]=std::abs(mat->segment)+7; }
+    while(mat++->segment>=0 && count<kMaxMatEntries);
+    ComboForeignTexAnim_Restore(play,segments,count,false);
+}
+
+extern "C" void Combo_SOHWindMaterial(PlayState* play,int step) {
+    Combo_SOHWarpMaterial(play,gSoaringWarpCsWindCapsuleTexAnim,step);
+}
+extern "C" int Combo_SOHWarpVertexCount(const char* path) {
+    auto count=(int(*)(const char*))Combo_ResolveSym("2ship","MM_WarpVertexCount");
+    return count ? count(path) : 0;
+}
+#endif
