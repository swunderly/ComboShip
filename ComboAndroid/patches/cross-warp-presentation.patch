+static Vec3f RelativeToPlayer(CrossSongWarp* this, Vec3f local) {
+    return (Vec3f){this->origin.x+local.x*Math_CosS(this->yaw)+local.z*Math_SinS(this->yaw),
+        this->origin.y+local.y,this->origin.z+local.z*Math_CosS(this->yaw)-local.x*Math_SinS(this->yaw)};
+}
+static const Color_RGB8 sWarpColors[]={{0,200,0},{255,50,0},{0,150,255},{255,150,0},{200,50,255},{200,255,0}};
+static const ALIGN_ASSET(2) char sFlashDL[]="__OTR__@oot:objects/gameplay_keep/gEffFlash1DL";
+static void CrossSongWarp_Init(Actor* actor, PlayState* play) {
+    CrossSongWarp* this=(CrossSongWarp*)actor; Player* player=GET_PLAYER(play);
+    this->origin=player->actor.world.pos; this->yaw=player->actor.shape.rot.y;
+    this->playerDraw=player->actor.draw;
+    Camera* main=Play_GetCamera(play,CAM_ID_MAIN);
+    this->subCamId=Play_CreateSubCamera(play);
+    Play_SetCameraAtEye(play,this->subCamId,&main->at,&main->eye);
+    Play_SetCameraFov(play,this->subCamId,main->fov);
+    Play_ChangeCameraStatus(play,CAM_ID_MAIN,CAM_STATUS_WAIT);
+    Play_ChangeCameraStatus(play,this->subCamId,CAM_STATUS_ACTIVE);
+    Player_SetCsActionWithHaltedActors(play,actor,PLAYER_CSACTION_10);
+    player->stateFlags1|=PLAYER_STATE1_20000000;
+    Audio_PlaySfx(NA_SE_EV_LINK_WARP);
+}
+static void CrossSongWarp_Destroy(Actor* actor, PlayState* play) {
+    CrossSongWarp* this=(CrossSongWarp*)actor; Player* player=GET_PLAYER(play);
+    if(player) {
+        player->actor.draw=this->playerDraw;
+        player->stateFlags1 &= ~PLAYER_STATE1_20000000;
+        Player_SetCsAction(play,actor,PLAYER_CSACTION_END);
+    }
+    play->envCtx.fillScreen=false;
+    Play_ClearCamera(play,this->subCamId); Play_ChangeCameraStatus(play,CAM_ID_MAIN,CAM_STATUS_ACTIVE);
+}
+static void CrossSongWarp_Update(Actor* actor, PlayState* play) {
+    CrossSongWarp* this=(CrossSongWarp*)actor; Player* player=GET_PLAYER(play);
+    // Keep the original animation duration and particle density in a 30 Hz world.
+    this->nativeTick+=2;
+    if(this->nativeTick<3) return;
+    this->nativeTick-=3;
+    if(this->count<30) this->count+=2;
+    for(int i=this->count-1;i>=0;i--) {
+        CWWarpParticle* p=&this->particles[i]; float taper=1.0f-i/(float)this->count;
+        if(!p->phase) {
+            p->offset=(Vec3f){(Rand_ZeroOne()-.5f)*16*taper,(Rand_ZeroOne()-.5f)*16*taper,(Rand_ZeroOne()-.5f)*16*taper};
+            p->phase=1;
+        }
+        if(p->phase==1) {
+            Vec3f pos; float roll,fov;
+            if(CWWarpSplineStep(&pos,&roll,&fov,sWarpOutCameraPoints,&p->key,&p->frame)) p->phase=2;
+            else {
+                p->pos.x=this->origin.x+pos.x*Math_CosS(this->yaw)+pos.z*Math_SinS(this->yaw);
+                p->pos.y=this->origin.y+pos.y;
+                p->pos.z=this->origin.z+pos.z*Math_CosS(this->yaw)-pos.x*Math_SinS(this->yaw);
+            }
+        }
+        if(!p->pulse) {p->scale=Rand_ZeroOne();p->pulse=1;}
+        if(p->pulse==1) {Math_SmoothStepToF(&p->scale,1,.5f,.4f,.2f); if(p->scale>=1) p->pulse=2;}
+        else {Math_SmoothStepToF(&p->scale,0,.5f,.3f,.2f); if(p->scale<=0) p->pulse=1;}
+        p->rotation+=0x190;
+    }
+    if(this->timer>=34) {
+        Vec3f eye,at; float roll,fov;
+        s16 key=this->camKey; f32 frame=this->camFrame;
+        CWWarpSplineStep(&eye,&roll,&fov,sEye,&key,&frame);
+        CWWarpSplineStep(&at,&roll,&fov,sAt,&this->camKey,&this->camFrame);
+        eye=RelativeToPlayer(this,eye); at=RelativeToPlayer(this,at);
+        Play_SetCameraAtEye(play,this->subCamId,&at,&eye); Play_SetCameraFov(play,this->subCamId,fov);
+    }
+    // Original white flash wraps the player disappearing, then fades back while
+    // the colored particles follow their ascending native spline.
+    play->envCtx.fillScreen=false;
+    play->envCtx.screenFillColor[0]=play->envCtx.screenFillColor[1]=play->envCtx.screenFillColor[2]=255;
+    int remaining=35-this->timer;
+    if(remaining<21 && remaining>=15) {
+        play->envCtx.fillScreen=true; play->envCtx.screenFillColor[3]=255-255*(remaining-15)/5;
+    } else if(remaining<15 && remaining>=4) {
+        play->envCtx.fillScreen=true; play->envCtx.screenFillColor[3]=255*(remaining-4)/10;
+    }
+    if(++this->timer==20) player->actor.draw=NULL;
+    if(this->particles[0].phase==2) {
+        Combo_MMCompleteWarp(play,actor->params); Actor_Kill(actor);
+    }
+}
+static void CrossSongWarp_Draw(Actor* actor, PlayState* play) {
+    CrossSongWarp* this=(CrossSongWarp*)actor;
+    OPEN_DISPS(play->state.gfxCtx);
+    Gfx_SetupDL25_Xlu(play->state.gfxCtx);
+    Color_RGB8 color=sWarpColors[play->msgCtx.songPlayed<6 ? play->msgCtx.songPlayed : 0];
+    for(int i=this->count-1;i>=0;i--) {
+        CWWarpParticle* p=&this->particles[i];
+        if(p->phase!=1) continue;
+        FrameInterpolation_RecordOpenChild("Cross Song Warp",i);
+        float scale=p->scale*(.018f*(1.0f-i/(float)this->count));
+        Matrix_Translate(p->pos.x+p->offset.x,p->pos.y+p->offset.y,p->pos.z+p->offset.z,MTXMODE_NEW);
+        Matrix_Scale(scale,scale,scale,MTXMODE_APPLY);
+        Matrix_Mult(&play->billboardMtxF,MTXMODE_APPLY); Matrix_RotateZF(DEG_TO_RAD(p->rotation),MTXMODE_APPLY);
+        gDPSetPrimColor(POLY_XLU_DISP++,0,0x80,255,255,255,255);
+        gDPSetEnvColor(POLY_XLU_DISP++,color.r,color.g,color.b,255);
+        MATRIX_FINALIZE_AND_LOAD(POLY_XLU_DISP++,play->state.gfxCtx);
+        gSPDisplayList(POLY_XLU_DISP++,sFlashDL);
+        FrameInterpolation_RecordCloseChild();
+    }
+    CLOSE_DISPS(play->state.gfxCtx);
+}
