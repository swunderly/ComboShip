+    }
+
+    for (i = 0; i < 4; i++) {
+        pointData[i][0] = point[key + i].pos.x;
+        pointData[i][1] = point[key + i].pos.y;
+        pointData[i][2] = point[key + i].pos.z;
+        pointData[i][3] = point[key + i].cameraRoll;
