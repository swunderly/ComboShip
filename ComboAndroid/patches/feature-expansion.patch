+// Physical state is supplied separately; a received pouch never mutates it.
+struct ReceivedState { std::array<uint8_t,PuzzleCount> counts{}; };
+struct Grant { uint8_t count; uint16_t rupees; bool solved; bool permanentSwitch; };
+inline Grant Receive(ReceivedState& received, size_t slot, bool mq, bool pouch,
+                     std::optional<uint8_t> activeScene = std::nullopt) {
+    const auto puzzle = GetPuzzle(slot,mq);
+    const unsigned amount = pouch ? puzzle.count : 1;
+    const auto total = unsigned(received.counts.at(slot)) + amount;
+    const auto count = static_cast<uint8_t>(total > puzzle.count ? puzzle.count : total);
+    received.counts.at(slot) = count;
+    const bool solved = puzzle.count && count == puzzle.count;
+    return {count,static_cast<uint16_t>(5*amount),solved,
+            solved && puzzle.flag < 0x20 && (!activeScene || *activeScene != puzzle.scene)};
+}
+// Reapply both permanent and temporary switches after room entry. Caller gates
+// this on normal game mode, no active message and no climbing, as upstream does.
+inline bool SolvedInScene(const ReceivedState& received,size_t slot,bool mq,uint8_t scene) {
+    const auto puzzle=GetPuzzle(slot,mq);
+    return puzzle.count && puzzle.scene==scene && received.counts.at(slot)>=puzzle.count;
+}
+inline std::optional<uint16_t> PhysicalId(uint8_t scene,int room,unsigned local,bool mq) {
+    unsigned base;
+    switch(scene) {
+      case 1: base=0; break;
+      case 8: base=5; break;
+      case 6:
+        switch(room) {case 0:case 2:base=0xa;break;case 8:case 0x17:base=0xf;break;case 0xd:base=0x14;break;default:return {};}
+        break;
+      case 7:
+        switch(room) {case 6:base=0x19;break;case 0x10:base=0x1e;break;case 9:base=0x28;break;case 0xb:base=0x2d;break;default:return {};}
+        break;
+      case 9:
+        switch(room) {case 3:base=0x37;break;case 5:base=0x3c;break;default:return {};}
+        break;
+      case 11:
+        switch(room) {case 2:base=0x41;break;case 6:base=0x46;break;case 9:base=0x4c;break;default:return {};}
+        break;
+      case 13:
+        switch(room) {case 0xc:case 0x11:base=0x51;break;case 3:case 8:base=0x56;break;case 0xe:base=0x5b;break;case 6:base=0x60;break;default:return {};}
+        break;
+      default:return {};
+    }
+    if(base+local>=0x80)return {};
+    const auto id=static_cast<uint16_t>((base+local)|(mq?0x80:0));
+    for(const auto& check:Checks) if(check.id==id && check.mq==mq)return id;
+    return {};
+}
+} // namespace Rando::SilverRupees
