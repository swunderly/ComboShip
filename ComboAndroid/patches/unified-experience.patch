+#pragma once
+#include <string>
+
+// Feature destinations, independent of engine ordering. Unknown pages stay reachable in Tools.
+namespace ComboRando {
+struct MenuDestination { std::string scope, page; };
+inline MenuDestination MenuRoute(bool oot, const std::string& section, const std::string& page) {
+    if (page == "Search") return {};
+    if (section == "Network") return {}; // Anchor is shared; unsupported integrations stay hidden.
+    if (section == "Randomizer" || section == "Rando") {
+        if (page == "Item Tracker" || page == "Check Tracker" || page == "Hint Tracker" || page == "Plandomizer") return {};
+        if (page.find("Tracker") != std::string::npos) return {"trackers", page};
+        if (page == "General") return {"randomizer", "World rules"};
+        if (page == "Locations" || page == "Check Exclusions") return {"randomizer", "Excluded checks"};
+        if (page == "Logic/Access" || page == "Logic/Conditions") return {"randomizer", "Logic & access"};
+        if (page == "Tricks/Glitches") return {"randomizer", "Tricks & glitches"};
+        if (page == "Hints/Traps" || page == "Hints") return {"randomizer", "Hints & traps"};
+        if (page == "Shuffles" || page == "Check Pool") return {"randomizer", "Check pool"};
+        return {"randomizer", page};
+    }
+    if (section == "Settings") {
+        if (page == "General") return {"gameplay", "Startup & accessibility"};
+        if (page == "Presets") return {"gameplay", "Presets"};
+        if (page == "Mod Menu") return {"tools", "Mods"};
+        if (page == "Overlay") return {"gameplay", "HUD & overlays"};
+        // The shared audio bridge and controller backend already drive both engines.
+        if (!oot && (page == "Audio" || page == "Graphics" || page == "Controls" || page == "Input Viewer")) return {};
+        return {"settings", page};
+    }
+    if (section == "Enhancements") {
+        if (page == "Timers") return {}; // Replaced by the combined timer.
+        if (page == "Quality of Life" || page == "Gameplay") return {"gameplay", "Quality of life"};
+        if (page == "Skips & Speed-ups" || page == "Time Savers") return {"gameplay", "Time savers"};
+        if (page == "Items" || page == "Items/Songs") return {"gameplay", "Items & songs"};
+        if (page == "Difficulty" || page == "Difficulty Options") return {"gameplay", "Difficulty"};
+        if (page == "Cosmetics Editor" || page == "Cosmetic Editor") return {"gameplay", "Appearance"};
+        if (page == "HUD Editor") return {"gameplay", "HUD & overlays"};
+        if (page == "Graphics") return {"gameplay", "Visual enhancements"};
+        if (page == "Audio Editor") return {"gameplay", "Music & sounds"};
+        if (page == "Gameplay Stats" || page == "Time Splits") return {"trackers", page};
+        return {"gameplay", page};
+    }
+    if (section == "Dev Tools") {
+        if (page == "General") return {"tools", "Developer options"};
+        if (page == "DList Viewer" || page == "DL Viewer") return {"tools", "Display lists"};
+        return {"tools", page};
+    }
+    return {"tools", section + " / " + page};
+}
