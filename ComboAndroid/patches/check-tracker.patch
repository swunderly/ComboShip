+ComboCheckInfo info{ 0, -1, -1 };
+struct Row {
+    int id;
+    uint32_t flags;
+    std::string name, type, reward, logic, searchable;
+};
+struct Area { int id; std::string name; std::vector<Row> rows; Totals totals; };
+std::vector<Area> areas;
+UniqueTotals totals;
+
+// Published by the render thread; Android's UI thread only sees a normalized rectangle.
+// Touches over the tracker go to ImGui instead of starting an invisible analog stick.
+std::mutex boundsMutex;
+float bounds[4]{};
+void PublishBounds(bool shown) {
+    std::lock_guard<std::mutex> lock(boundsMutex);
+    if (!shown) { std::fill(std::begin(bounds), std::end(bounds), 0.0f); return; }
+    const ImVec2 p = ImGui::GetWindowPos(), s = ImGui::GetWindowSize(), d = ImGui::GetIO().DisplaySize;
+    bounds[0] = p.x / d.x; bounds[1] = p.y / d.y;
+    bounds[2] = (p.x + s.x) / d.x; bounds[3] = (p.y + s.y) / d.y;
+}
+
+struct GameAPI { ComboCheckSnapshot snapshot = nullptr; ComboCheckSetSkipped skip = nullptr; };
+const GameAPI& API(int game) {
+    static GameAPI api[2];
+    // Retry until mapped: MM can register later than comboui during startup.
+    auto& a = api[game];
+    if (!a.snapshot) a.snapshot = reinterpret_cast<ComboCheckSnapshot>(Combo_ResolveSym(
+        game ? "2ship" : "soh", game ? "MM_ComboCheckSnapshot" : "SOH_ComboCheckSnapshot"));
+    if (!a.skip) a.skip = reinterpret_cast<ComboCheckSetSkipped>(Combo_ResolveSym(
+        game ? "2ship" : "soh", game ? "MM_ComboCheckSetSkipped" : "SOH_ComboCheckSetSkipped"));
+    return a;
+}
+void Save() {
+    Ship::Context::GetRawInstance()->GetWindow()->GetGui()->SaveConsoleVariablesNextFrame();
+    dirty = true;
+}
+bool Check(const char* label, const char* cvar, int def) {
+    bool value = CVarGetInteger(cvar, def) != 0;
+    if (!ImGui::Checkbox(label, &value)) return false;
+    CVarSetInteger(cvar, value); Save(); return true;
+}
+void Collect(const ComboCheckRow* row, void*) {
+    if (!row) return;
+    auto group = std::find_if(areas.begin(), areas.end(), [&](const Area& a) { return a.id == row->area; });
+    if (group == areas.end()) {
+        areas.push_back({ row->area, row->areaName ? row->areaName : "Other", {}, {} });
+        group = areas.end() - 1;
+    }
+    Row r{ row->id, row->flags, row->name ? row->name : "", row->type ? row->type : "",
+           row->reward ? row->reward : "", row->logic ? row->logic : "", "" };
+    r.searchable = group->name + " " + r.name + " " + r.type + " " + r.reward;
+    group->totals.Add(r.flags); totals.Add(r.id, r.flags);
+    group->rows.push_back(std::move(r));
+}
+struct Button { const char* name; uint32_t mask; };
+constexpr Button buttons[] = { {"L",0x20}, {"R",0x10}, {"Z",0x2000}, {"Start",0x1000},
+    {"A",0x8000}, {"B",0x4000}, {"Modifier 1",0x40}, {"Modifier 2",0x80},
+    {"D-Up",0x800}, {"D-Down",0x400}, {"D-Left",0x200}, {"D-Right",0x100},
+    {"C-Up",0x8}, {"C-Down",0x4}, {"C-Left",0x2}, {"C-Right",0x1} };
+std::string ShortcutLabel() {
+    const uint32_t mask = CVarGetInteger(kShortcut, 0x20);
+    std::string result;
+    for (auto b : buttons) if (b.mask & mask) { if (!result.empty()) result += " + "; result += b.name; }
+    return result.empty() ? "None selected" : result;
+}
+void Migrate() {
+    // The compact 2S2H-style side panel is the new presentation default.
+    // Existing visibility modes, shortcuts, filters and save flags are retained.
+    if (!CVarGetInteger("gCombo.CheckTracker.CompactVersion", 0)) {
+        CVarSetInteger("gCombo.CheckTracker.CompactVersion", 1);
+        CVarSetInteger("gCombo.CheckTracker.WindowType", 2);
+        Save();
+    }
+    if (CVarGetInteger("gCombo.CheckTracker.UnifiedVersion", 0)) return;
+    CVarSetInteger("gCombo.CheckTracker.UnifiedVersion", 1);
+    // Keep the user's MM toggle/chord, as it already supports both tap and hold.
+    CVarSetInteger(kMode, std::clamp(CVarGetInteger("gRando.CheckTracker.VisibilityMode", Toggle), 0, 3));
+    uint32_t mask = CVarGetInteger("gRando.CheckTracker.VisibilityBtn", 0x20) & 0xffff;
+    CVarSetInteger(kShortcut, mask ? mask : 0x20);
+    CVarSetFloat("gCombo.CheckTracker.Scale", std::clamp(CVarGetFloat("gRando.CheckTracker.Scale", 1), 0.7f, 2.5f));
+    CVarSetFloat("gCombo.CheckTracker.Opacity", std::clamp(CVarGetFloat("gRando.CheckTracker.Opacity", .75f), 0.1f, 1.0f));
+    CVarSetInteger("gCombo.CheckTracker.Collected", CVarGetInteger("gRando.CheckTracker.CollectedMode", 2) != 2);
+    CVarSetInteger("gCombo.CheckTracker.Skipped", CVarGetInteger("gRando.CheckTracker.SkippedMode", 2) != 2);
+    CVarSetInteger("gCombo.CheckTracker.CurrentArea", CVarGetInteger("gRando.CheckTracker.ShowCurrentScene", 0));
+    CVarSetInteger("gCombo.CheckTracker.AutoScroll", CVarGetInteger("gRando.CheckTracker.ScrollToCurrentScene", 1));
+    CVarSetInteger("gCombo.CheckTracker.ShowLogic", CVarGetInteger("gRando.CheckTracker.OutOfLogicMode", 1) != 0);
+    CVarSetInteger("gCombo.CheckTracker.AvailableOnly", CVarGetInteger("gRando.CheckTracker.OutOfLogicMode", 1) == 2);
+    Save();
+}
+void SuppressOldWindows() {
+    for (int g = 0; g < 2; ++g) for (int i : {2,3}) {
+        const auto& w = ComboTracker::kTrackers[g][i];
+        auto win = Ship::Context::GetRawInstance()->GetWindow()->GetGui()->GetGuiWindow(w.name);
+        if (CVarGetInteger(w.cvar, 0) || (win && win->IsVisible())) ComboTracker::SetTracker(w, false);
+    }
+}
+const char* Status(const Row& row) {
+    if (IsCollected(row.flags)) return "Collected";
+    if (IsSkipped(row.flags)) return "Skipped";
+    if (row.flags & COMBO_CHECK_SCUMMED) return "Unsaved";
+    if (row.flags & COMBO_CHECK_SEEN) return "Seen";
+    if (row.flags & COMBO_CHECK_LOGIC_KNOWN) return OutOfLogic(row.flags) ? "Unavailable" : "Available";
+    return "Unchecked";
+}
+ImVec4 Color(const Row& row) {
+    if (IsCollected(row.flags)) return { .45f, .9f, .6f, 1 };
+    if (IsSkipped(row.flags)) return { 1.0f, .4f, 1.0f, 1 };
+    if (row.flags & (COMBO_CHECK_SEEN | COMBO_CHECK_SCUMMED)) return { .55f, .8f, 1, 1 };
+    if (OutOfLogic(row.flags)) return { .6f, .63f, .68f, 1 };
+    return { .95f, .95f, .97f, 1 };
+}
+
+const char* TypeIcon(const Row& row) {
+    if (row.type == "Heart") return ICON_FA_HEART;
+    if (row.type == "Song") return ICON_FA_MUSIC;
+    if (row.type == "Shop") return ICON_FA_SHOPPING_BAG;
+    if (row.type == "Chest" || row.name.find("Chest") != std::string::npos) return ICON_FA_ARCHIVE;
+    if (row.type == "Crate" || row.type == "Barrel" || row.type == "Pot") return ICON_FA_CUBE;
+    if (row.type == "Skulltula" || row.type == "Beehive") return ICON_FA_BUG;
+    if (row.type == "Fairy" || row.type == "Wonder item") return ICON_FA_MAGIC;
+    if (row.type == "Grass" || row.type == "Tree") return ICON_FA_LEAF;
+    if (row.type == "Cow" || row.type == "Frog" || row.type == "Fish") return ICON_FA_PAW;
+    if (row.type == "Dungeon reward") return ICON_FA_STAR;
+    if (row.type == "Freestanding") return ICON_FA_DIAMOND;
+    return ICON_FA_GIFT;
+}
+
+std::string RowLabel(const Row& row) {
+    std::string label = row.name;
+    if (IsSkipped(row.flags)) label += " (Skipped)";
+    else if (IsCollected(row.flags)) label += " (" + (row.reward.empty() ? std::string("Collected") : row.reward) + ")";
+    else if (row.flags & COMBO_CHECK_SCUMMED) label += " (Unsaved)";
+    else if (row.flags & COMBO_CHECK_SEEN) label += " (Seen)";
+    return label;
+}
