+    const ImVec4 theme = ComboMenu_ThemeColor();
+    ComboMenu_PushCheckbox(theme);
+    Check("Enable check tracker", kEnabled, 0);
+    ComboMenu_PopCheckbox();
+    ImGui::TextWrapped("One tracker follows the game you are playing. Its layout, shortcut and filters are shared.");
+    ImGui::Spacing();
+    if (ImGui::BeginTable("##shared-check-settings", 2, ImGuiTableFlags_SizingStretchSame | ImGuiTableFlags_NoSavedSettings)) {
+        ImGui::TableNextColumn();
+        ImGui::SeparatorText("Open and close");
+        int mode = std::clamp(CVarGetInteger(kMode, Toggle), 0, 3);
+        const char* modes[] = { "Always", "While paused", "Button toggle", "Button hold" };
+        ComboMenu_PushCombobox(theme);
+        if (ImGui::Combo("Visibility", &mode, modes, 4)) { CVarSetInteger(kMode, mode); Save(); }
+        ComboMenu_PopCombobox();
+        if (mode == Toggle || mode == Hold) {
+            ImGui::TextWrapped("Shortcut: %s", ShortcutLabel().c_str());
+            ImGui::TextWrapped(mode == Toggle ? "Press once to open; press again to close." : "Hold the shortcut to show the tracker.");
+            if (ImGui::CollapsingHeader("Change shortcut")) {
