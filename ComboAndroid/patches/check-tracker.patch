+class Window final : public Ship::GuiWindow {
+  public:
+    using GuiWindow::GuiWindow;
+    void Draw() override {
+        auto ctx = Ship::Context::GetRawInstance();
+        if (!ctx || !ctx->GetWindow() || !ctx->GetWindow()->GetGui()) return;
+        ImGui::SetCurrentContext(ctx->GetWindow()->GetGui()->GetImGuiContext());
+        SuppressOldWindows();
+        const int game = ComboUI::GetForegroundGame() == 1 ? 1 : 0;
+        const auto& api = API(game);
+        info = {0, -1, -1};
+        if (api.snapshot) api.snapshot(&info, nullptr, nullptr);
+        const int context = info.loaded ? game * 4 + info.slot : -1;
+        if (lastContext != context) {
+            areas.clear(); totals = {}; search.Clear(); selectedCheck = -1;
+            dirty = true; scrollToArea = true; lastContext = context; lastArea = -1;
+        }
+        if (lastArea != info.currentArea) { lastArea = info.currentArea; scrollToArea = true; dirty = true; }
+        auto deck = std::dynamic_pointer_cast<LUS::ControlDeck>(ctx->GetControlDeck());
+        const auto* pads = deck ? deck->GetPads() : nullptr;
+        const uint32_t held = pads ? pads[0].button : 0;
+        const int mode = std::clamp(CVarGetInteger(kMode, Toggle), 0, 3);
+        const bool menu = CVarGetInteger("gOpenWindows.Menu", 0) != 0;
+        const bool shortcutBlocked = menu || ImGui::GetIO().WantTextInput;
+        const bool show = visibility.Update(context, mode, CVarGetInteger(kShortcut, 0x20), held,
+            CVarGetInteger(kEnabled, 0), info.loaded, ComboTracker::ForegroundPaused(game), shortcutBlocked);
+        if (!show) { PublishBounds(false); return; }
+        if (dirty || ImGui::GetTime() - lastRefresh >= .3) {
+            areas.clear(); totals = {};
+            api.snapshot(&info, Collect, nullptr);
+            for (auto& area : areas) std::stable_sort(area.rows.begin(), area.rows.end(), [](const Row& a, const Row& b) {
+                if (IsCollected(a.flags) != IsCollected(b.flags)) return !IsCollected(a.flags);
+                return a.name < b.name;
+            });
+            dirty = false; lastRefresh = ImGui::GetTime();
+        }
+        const ImVec2 display = ImGui::GetIO().DisplaySize;
+        const float scale = std::clamp(CVarGetFloat("gCombo.CheckTracker.Scale", 1), .7f, 2.5f);
+        const float unit = std::max(1.0f, ImGui::GetFontSize() / 16);
+        const int style = std::clamp(CVarGetInteger("gCombo.CheckTracker.WindowType", 2), 0, 2);
+        const bool sidePanel = style == 2, overlay = style == 0;
+        if (sidePanel) DockBesideGame();
+        else {
+            ImGui::SetNextWindowDockID(0);
+            const ImVec2 size(std::min(display.x * .7f, 485 * unit), std::min(display.y * .8f, 500 * unit));
+            const ImGuiCond condition = lastStyle != style ? ImGuiCond_Always : ImGuiCond_FirstUseEver;
+            ImGui::SetNextWindowSize(size, condition);
+            ImGui::SetNextWindowPos(ImVec2(display.x - size.x - 20, 50), condition);
+        }
+        lastStyle = style;
+        ImGui::SetNextWindowSizeConstraints(ImVec2(std::min(220 * unit, display.x * .4f), std::min(160 * unit, display.y * .5f)), display);
+        ImGui::SetNextWindowBgAlpha(sidePanel ? 1.0f : std::clamp(CVarGetFloat("gCombo.CheckTracker.Opacity", .75f), .1f, 1.0f));
+        ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0,0,0,1));
+        ImGui::PushStyleColor(ImGuiCol_Header, ImVec4(0,0,0,0));
+        ImGui::PushStyleColor(ImGuiCol_HeaderHovered, ImVec4(.3f,.35f,.4f,.35f));
+        ImGui::PushStyleColor(ImGuiCol_HeaderActive, ImVec4(.3f,.35f,.4f,.5f));
+        ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(8, 4));
+        ImGuiWindowFlags flags = ImGuiWindowFlags_NoFocusOnAppearing;
+        if (!sidePanel) flags |= ImGuiWindowFlags_NoDocking;
+        if (overlay) flags |= ImGuiWindowFlags_NoTitleBar;
+        bool open = true;
+        if (ImGui::Begin(kTitle, &open, flags)) {
+            ImGui::SetWindowFontScale(scale);
+            PublishBounds(!menu);
+            if (overlay) {
+                ImGui::TextUnformatted("Check Tracker"); ImGui::SameLine();
+                if (ImGui::SmallButton("Close")) open = false;
+            }
+            const bool showTools = CVarGetInteger("gCombo.CheckTracker.ShowTools", 0);
+            if (showTools) {
+                ImGui::TextUnformatted(game ? "Majora's Mask" : "Ocarina of Time");
+                ImGui::Text("%d / %d collected  |  %d skipped%s", totals.collected, totals.total, totals.skipped,
+                            totals.hiddenArea ? "  (known areas)" : "");
+                ComboMenu_PushInput(ComboMenu_ThemeColor());
+                ImGui::SetNextItemWidth(-1);
+                if (ImGui::InputTextWithHint("##search", "Search checks, areas, types or known rewards", search.InputBuf, sizeof(search.InputBuf))) search.Build();
+                ComboMenu_PopInput();
+                ComboMenu_PushCheckbox(ComboMenu_ThemeColor());
+                Check("Collected", "gCombo.CheckTracker.Collected", 0); ImGui::SameLine();
+                Check("Skipped", "gCombo.CheckTracker.Skipped", 0); ImGui::SameLine();
+                Check("Current area", "gCombo.CheckTracker.CurrentArea", 0);
+                ComboMenu_PopCheckbox();
+                ComboMenu_PushButton(ComboMenu_ThemeColor());
+                if (ImGui::Button("Expand all")) expandAll = 1;
+                ImGui::SameLine(); if (ImGui::Button("Collapse all")) expandAll = 0;
+                ImGui::SameLine(); if (ImGui::Button("Find current")) { scrollToArea = true; forceScroll = true; }
+                ComboMenu_PopButton();
+                ImGui::Separator();
+            } else if (search.IsActive()) { search.Clear(); }
+            if (ImGui::BeginChild("Checks", ImVec2(0,0), false, ImGuiWindowFlags_HorizontalScrollbar)) DrawRows(game);
+            ImGui::EndChild();
+            DrawDetails(api, display, unit);
+        } else PublishBounds(!menu);
+        ImGui::End(); ImGui::PopStyleVar(); ImGui::PopStyleColor(4);
+        if (!open) {
+            if (mode == Toggle) visibility.open = false;
+            else { CVarSetInteger(kEnabled, 0); Save(); }
+            PublishBounds(false);
+        }
+    }
+  protected:
+    void InitElement() override {}
+    void UpdateElement() override {}
+    void DrawElement() override {}
+  private:
+    bool forceScroll = false;
+    bool openDetails = false;
+    int lastStyle = -1;
+    ImGuiID sideDock = 0;
+
+    void DockBesideGame() {
+        // Split only the game's existing leaf. Other docked tools retain their layout.
+        // ImGui hides an inactive dock leaf, restoring the game's space when toggled off.
+        auto* tracker = ImGui::FindWindowByName(kTitle);
+        if (!sideDock && tracker && tracker->DockId) sideDock = tracker->DockId;
+        // A hidden tracker has no live ImGui window after a cold launch. Reuse
+        // its saved dock instead of splitting the game again and losing the divider.
+        if (!sideDock && !tracker) {
+            if (auto* settings = ImGui::FindWindowSettingsByID(ImHashStr(kTitle))) sideDock = settings->DockId;
+        }
+        if (!sideDock || !ImGui::DockBuilderGetNode(sideDock)) {
+            auto* main = ImGui::FindWindowByName("Main Game");
+            auto* node = main ? ImGui::DockBuilderGetNode(main->DockId) : nullptr;
+            if (node && !node->IsSplitNode()) {
+                const ImGuiID root = node->ID;
+                ImGuiID gameDock = 0;
+                sideDock = ImGui::DockBuilderSplitNode(root, ImGuiDir_Right, .5f, nullptr, &gameDock);
+                ImGui::DockBuilderDockWindow("Main Game", gameDock);
+                ImGui::DockBuilderDockWindow(kTitle, sideDock);
+                if (auto* panel = ImGui::DockBuilderGetNode(sideDock))
+                    panel->LocalFlags &= ~(ImGuiDockNodeFlags_NoTabBar | ImGuiDockNodeFlags_HiddenTabBar);
+                ImGui::DockBuilderFinish(root);
+            }
+        }
+        if (sideDock) ImGui::SetNextWindowDockID(sideDock);
+    }
+
+    void DrawRows(int game) {
+        const bool showCollected = CVarGetInteger("gCombo.CheckTracker.Collected", 0);
+        const bool showSkipped = CVarGetInteger("gCombo.CheckTracker.Skipped", 0);
+        const bool currentOnly = CVarGetInteger("gCombo.CheckTracker.CurrentArea", 0);
+        const bool availableOnly = CVarGetInteger("gCombo.CheckTracker.ShowLogic", 1) && CVarGetInteger("gCombo.CheckTracker.AvailableOnly", 0);
+        const bool autoScroll = CVarGetInteger("gCombo.CheckTracker.AutoScroll", 1) || forceScroll;
+        int shown = 0;
+        ImGui::PushID(game);
+        for (const auto& area : areas) {
+            if (currentOnly && area.id != info.currentArea) continue;
+            std::vector<const Row*> rows;
+            for (const auto& row : area.rows)
+                if (PassesFilters(row.flags, showCollected, showSkipped, availableOnly) && search.PassFilter(row.searchable.c_str())) rows.push_back(&row);
+            if (rows.empty()) continue;
+            ++shown;
+            ImGui::PushID(area.id);
+            ImGui::Separator();
+            const bool target = scrollToArea && autoScroll && area.id == info.currentArea && !search.IsActive();
+            if (expandAll >= 0) ImGui::SetNextItemOpen(expandAll != 0);
+            else if (target) ImGui::SetNextItemOpen(true);
+            else ImGui::SetNextItemOpen(area.id == info.currentArea, ImGuiCond_Once);
+            std::string heading = area.name + (area.totals.hiddenArea ? " (?)" :
+                " (" + std::to_string(area.totals.collected) + "/" + std::to_string(area.totals.total) + ")") + "###area";
+            const bool complete = !area.totals.hiddenArea && area.totals.collected == area.totals.total;
+            ImGui::PushStyleColor(ImGuiCol_Text, complete ? ImVec4(.4f,1,.4f,1) : ImVec4(1,1,1,1));
+            bool expanded = ImGui::CollapsingHeader(heading.c_str());
+            ImGui::PopStyleColor();
+            if (target) { ImGui::SetScrollHereY(0); scrollToArea = false; forceScroll = false; }
+            if (expanded) ImGui::Indent(ImGui::GetFontSize() * .65f);
+            if (expanded) for (const Row* row : rows) {
+                if (row->flags & COMBO_CHECK_AREA_HIDDEN) { ImGui::TextWrapped("%s", row->name.c_str()); continue; }
+                ImGui::PushID(row->id);
+                ImGui::PushStyleColor(ImGuiCol_Text, Color(*row));
+                ImGui::TextUnformatted(TypeIcon(*row)); ImGui::SameLine();
+                const std::string label = RowLabel(*row) + "##check";
+                if (ImGui::Selectable(label.c_str(), false, 0, ImVec2(0, ImGui::GetTextLineHeight() * 1.15f))) {
+                    selectedCheck = row->id; openDetails = true;
+                }
+                ImGui::PopStyleColor();
+                ImGui::PopID();
+            }
+            if (expanded) ImGui::Unindent(ImGui::GetFontSize() * .65f);
+            ImGui::PopID();
+        }
+        ImGui::PopID();
+        expandAll = -1;
+        if (!shown) ImGui::TextWrapped("No checks match these filters. Try showing collected or skipped checks, clearing search, or turning off Current area.");
+    }
+
+    void DrawDetails(const GameAPI& api, ImVec2 display, float unit) {
+        if (openDetails) { ImGui::OpenPopup("Check details"); openDetails = false; }
+        ImGui::SetNextWindowSize(ImVec2(std::min(420 * unit, display.x * .8f), 0), ImGuiCond_Appearing);
+        if (ImGui::BeginPopup("Check details")) {
+            const Row* selected = nullptr;
+            for (const auto& area : areas) for (const auto& row : area.rows)
+                if (row.id == selectedCheck) selected = &row;
+            if (!selected) ImGui::CloseCurrentPopup();
+            else {
+                ImGui::TextWrapped("%s", selected->name.c_str());
+                ImGui::TextColored(Color(*selected), "%s | %s", Status(*selected), selected->type.c_str());
+                if (!selected->reward.empty()) ImGui::TextWrapped("Reward: %s", selected->reward.c_str());
+                if (!selected->logic.empty() && ImGui::TreeNode("Logic details")) {
+                    ImGui::TextWrapped("%s", selected->logic.c_str()); ImGui::TreePop();
+                }
+                ComboMenu_PushButton(ComboMenu_ThemeColor());
+                if (!IsCollected(selected->flags) && api.skip) {
+                    if (ImGui::Button(IsSkipped(selected->flags) ? "Unskip check" : "Skip check")) {
+                        dirty = api.skip(info.slot, selected->id, !IsSkipped(selected->flags)) != 0;
+                        ImGui::CloseCurrentPopup();
+                    }
+                    ImGui::SameLine();
+                }
+                if (ImGui::Button("Close")) ImGui::CloseCurrentPopup();
+                ComboMenu_PopButton();
+            }
+            ImGui::EndPopup();
+        }
+    }
+};
+std::shared_ptr<Window> window;
+} // namespace
