+void RegisterCheckTrackerWindow() {
+    Migrate();
+    if (!window) window = std::make_shared<Window>("", true, " Combo Check Tracker");
+    Ship::Context::GetRawInstance()->GetWindow()->GetGui()->AddGuiWindow(window);
+}
