--- a/mm/2s2h/Rando/Logic/Logic.cpp
+++ b/mm/2s2h/Rando/Logic/Logic.cpp
@@ -14,6 +14,96 @@
 std::map<RandoRegionId, RandoRegion> Regions = {};
 
 uint64_t gCurrentRegionTime = 0;
+
+#ifdef COMBO_BUILD
+namespace {
+uint32_t RefillResource(RandoItemId item) {
+    using namespace ComboRando;
+    switch (item) {
+        case RI_ARROWS_10: case RI_ARROWS_30: case RI_ARROWS_50: return MmArrows;
+        case RI_BOMBS_5: case RI_BOMBS_10: return MmBombs;
+        case RI_BOMBCHU: case RI_BOMBCHU_5: case RI_BOMBCHU_10: return MmBombchus;
+        case RI_DEKU_STICK: case RI_DEKU_STICKS_5: return MmSticks;
+        case RI_DEKU_NUT: case RI_DEKU_NUTS_5: case RI_DEKU_NUTS_10: return MmNuts;
+        case RI_MAGIC_JAR_SMALL: case RI_MAGIC_JAR_BIG: return MmMagic;
+        case RI_GREEN_POTION_REFILL: case RI_BLUE_POTION_REFILL: case RI_CHATEAU_ROMANI_REFILL:
+            return HAS_BOTTLE ? MmMagic : 0;
+        default: return 0; // One-time equipment and foreign deliveries are not refills.
+    }
+}
+
+uint32_t OutdoorResources(RandoRegionId region) {
+    using namespace ComboRando;
+    uint32_t result = 0;
+    // Pinned OoTMM v32.3 world/mm/overworld. These sources dominate the other
+    // MM refill events while ordinary MM entrances remain unshuffled.
+    switch (region) {
+        case RR_TERMINA_FIELD:
+            result = MmRupees | MmArrows | MmBombs;
+            if (HaveEnemySoul(ACTOR_EN_SLIME)) result |= MmMagic;
+            if (HaveEnemySoul(ACTOR_EN_DEKUBABA) && (CAN_USE_SWORD || CAN_BE_DEKU)) result |= MmSticks;
+            break;
+        case RR_SOUTHERN_SWAMP_NORTH:
+            result = MmRupees | MmArrows | MmBombs | MmMagic | MmSticks;
+            break;
+        case RR_CLOCK_TOWN_NORTH: result = MmRupees; break;
+        case RR_CLOCK_TOWN_LAUNDRY: result = MmMagic; break;
+        case RR_WOODFALL_OWL_STATUE_PLATFORM: result = MmSticks | MmNuts; break;
+        default: return 0;
+    }
+    if ((region == RR_TERMINA_FIELD || region == RR_SOUTHERN_SWAMP_NORTH) &&
+        HaveEnemySoul(ACTOR_EN_DEKUBABA) &&
+        (CAN_USE_SWORD || CAN_BE_GORON || CAN_BE_ZORA || CAN_BE_DEKU ||
+         HAS_ITEM(ITEM_HOOKSHOT) || CAN_USE_EXPLOSIVE || CAN_USE_BOW)) {
+        result |= MmNuts;
+    }
+    return result;
+}
+} // namespace
+
+bool UpdateResourceSources(const std::set<RandoRegionId>& reached,
+                          std::unordered_map<RandoRegionId, RegionTimeState>& times) {
+    bool changed = false;
+    struct RestoreTime {
+        uint64_t previous = gCurrentRegionTime;
+        ~RestoreTime() { gCurrentRegionTime = previous; }
+    } restoreTime;
+    for (auto id : reached) {
+        const auto time = times.find(id);
+        const auto region = Regions.find(id);
+        if (time == times.end() || !time->second.timeSlices || region == Regions.end()) continue;
+        changed |= ComboRando::mmResourceAccess.Add(OutdoorResources(id));
+        gCurrentRegionTime = time->second.timeSlices;
+        for (const auto& [check, predicate] : region->second.checks) {
+            const auto definition = Rando::StaticData::Checks.find(check);
+            if (definition == Rando::StaticData::Checks.end() ||
+                definition->second.randoCheckType != RCTYPE_SHOP) continue;
+            const auto refill = RefillResource(RANDO_SAVE_CHECKS[check].randoItemId);
+            if (!refill || ComboRando::mmResourceAccess.Has(static_cast<ComboRando::MmResource>(refill))) continue;
+            // Vanilla refill shelves are paid even though RandoSaveCheck.price
+            // is zero for unshuffled stock. All use the base wallet except
+            // Chateau (200). Shuffled shelves use their rolled price instead.
+            if (!RANDO_SAVE_CHECKS[check].shuffled &&
+                !CAN_PAY(check == RC_MILK_BAR_PURCHASE_CHATEAU ? 200 : 1)) continue;
+            // Old pool dumps also rolled unused prices for vanilla shelves.
+            // Native purchases ignore those prices; evaluate the shelf with
+            // its real wallet gate above, then restore the save unchanged.
+            auto& checkSave = RANDO_SAVE_CHECKS[check];
+            struct RestorePrice {
+                decltype(checkSave.price)& destination;
+                decltype(checkSave.price) previous;
+                ~RestorePrice() { destination = previous; }
+            } restorePrice{checkSave.price, checkSave.price};
+            if (!RANDO_SAVE_CHECKS[check].shuffled) RANDO_SAVE_CHECKS[check].price = 0;
+            const bool available = TimeLogic::EvaluateConditionTimes(predicate.first, gCurrentRegionTime);
+            if (available) {
+                changed |= ComboRando::mmResourceAccess.Add(refill);
+            }
+        }
+    }
+    return changed;
+}
+#endif
 
