diff --git a/mm/2s2h/BenJsonConversions.hpp b/mm/2s2h/BenJsonConversions.hpp
--- a/mm/2s2h/BenJsonConversions.hpp
+++ b/mm/2s2h/BenJsonConversions.hpp
@@ -81,7 +81,22 @@
 
 inline void from_json(const json& j, RandoSaveInfo& rando) {
     j.at("randoInf").get_to(rando.randoInf);
+#ifdef COMBO_BUILD
+    // Logic updates appended Scarecrow and four dungeon search events after the
+    // 83 entries in older saves (84 entries before 0.2.14, 88 since 0.2.14).
+    // Preserve that prefix and initialize only the new events. Do not relax the
+    // reads of inventory, checks, options, or malformed/truncated event arrays.
+    const auto& savedEvents = j.at("randoEvents");
+    if (!savedEvents.is_array() || savedEvents.size() < RE_LEARN_SCARECROW_SONG ||
+        savedEvents.size() > RE_MAX) {
+        throw std::runtime_error("Unsupported MM logic event array length");
+    }
+    u8 events[RE_MAX] = {};
+    for (size_t i = 0; i < savedEvents.size(); ++i) savedEvents.at(i).get_to(events[i]);
+    std::copy(std::begin(events), std::end(events), std::begin(rando.randoEvents));
+#else
     j.at("randoEvents").get_to(rando.randoEvents);
+#endif
     j.at("randoSaveChecks").get_to(rando.randoSaveChecks);
     j.at("finalSeed").get_to(rando.finalSeed);
     j.at("randoSaveOptions").get_to(rando.randoSaveOptions);
