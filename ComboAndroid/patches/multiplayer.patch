+                    packet["state"]["events"] = sAnchorEvents;
+                    packet["state"]["crossChecks"] = sAppliedCrossChecks;
+                }
+                QueueWire(packet);
+            }
+        } catch (const std::exception& e) {
+            sSnapshotCapture = nullptr;
+            std::cerr << "[ComboShip][Anchor] Snapshot unavailable: " << e.what() << std::endl;
+        }
+    }
 }
 
