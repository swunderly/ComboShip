+        buyable = ScrubForeignStock(id, stock) && (stock.kind == 1 ? ScrubStockBuyable(RI_RECOVERY_HEART) : stock.buyable);
+    }
+    if (!buyable) return 2;
+    if (gSaveContext.save.saveInfo.playerData.rupees < kScrubPrices[id]) return 1;
+    actor->unk_364 = -kScrubPrices[id];
