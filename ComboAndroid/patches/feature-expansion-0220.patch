+inline bool MmSwampKillOctoClose(){return CAN_BE_ZORA||CAN_USE_NAYRUS_LOVE||CAN_USE_DINS_FIRE||CAN_USE_BOW||HAS_ITEM(ITEM_HOOKSHOT);}
