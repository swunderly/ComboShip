+// Pinned object_link_child 0x15BA8; verified native XML and local USA ROM list.
+// OTR adds one expanded marker and expands resource-reference commands. Count raw commands,
+// never interpret ROM byte offsets as native Instructions indices.
+template<class Command> bool StripPinnedFairyOcarinaHand(const std::vector<Command>& source,
+    std::vector<Command>& result, uint8_t marker, uint8_t texture, uint8_t vertex, uint8_t list) {
+    static constexpr uint8_t raw[] = {0xe7, 0xe3, 0xd7, 0xfd, 0xf5, 0xe6, 0xf3, 0xe7, 0xf5, 0xf2, 0xfc, 0xe2, 0xd9, 0xd9, 0xfa, 0x1, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x1, 0x6, 0xe7, 0xe3, 0xfd, 0xf5, 0xe6, 0xf3, 0xe7, 0xf5, 0xf2, 0xfd, 0xe8, 0xf5, 0xe6, 0xf0, 0xe7, 0x1, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x1, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0x6, 0xdf};
+    result.clear();
+    if (source.size()<2 || uint8_t(source[0].words.w0>>24)!=marker) return false;
+    size_t at=2;
+    for (size_t ordinal=0;ordinal<sizeof(raw);++ordinal) {
+        if (at>=source.size()) { result.clear(); return false; }
+        const uint8_t expected=raw[ordinal]==0xfd?texture:raw[ordinal]==1?vertex:raw[ordinal]==0xde?list:raw[ordinal];
+        const uint8_t opcode=uint8_t(source[at].words.w0>>24);
+        if (opcode!=expected) { result.clear(); return false; }
+        const size_t width=(opcode==texture||opcode==vertex||opcode==list)?2:1;
+        if(at+width>source.size()){result.clear();return false;}
+        if(ordinal<34 || ordinal>=72) result.insert(result.end(),source.begin()+at,source.begin()+at+width);
+        at+=width;
+    }
+    if(at!=source.size()){result.clear();return false;}
+    return true;
+}
+}
diff --git a/combo/menu/ComboFairyOcarinaHand.h b/combo/menu/ComboFairyOcarinaHand.h
new file mode 100644
--- /dev/null
+++ b/combo/menu/ComboFairyOcarinaHand.h
@@ -0,0 +1,37 @@
+#pragma once
+#include "ComboFairyOcarinaGeometry.h"
+#include <fast/resource/type/DisplayList.h>
+#include <fast/lus_gbi.h>
+#include <ship/resource/CrossRMRegistry.h>
+#include <ship/resource/ResourceManager.h>
+static std::shared_ptr<Ship::IResource> sFairyInstrumentSource;
+static std::shared_ptr<Fast::DisplayList> sFairyInstrumentCopy;
+static std::weak_ptr<Ship::ResourceManager> sFairyInstrumentOwner;
+static bool sFairyInstrumentListener;
+static void Combo_DropFairyInstrument() {sFairyInstrumentCopy.reset();sFairyInstrumentSource.reset();sFairyInstrumentOwner.reset();}
+static const char* Combo_FairyInstrumentPath() {
+    auto rm=Ship::CrossRMRegistry::Get("oot");if(!rm)return nullptr;
+    if(sFairyInstrumentOwner.lock()!=rm) {
+        auto source=std::dynamic_pointer_cast<Fast::DisplayList>(rm->LoadResource("objects/object_link_child/gLinkChildRightHandHoldingFairyOcarinaNearDL"));
+        if(!source)return nullptr;
+        auto copy=std::make_shared<Fast::DisplayList>(source->GetInitData());copy->UCode=source->UCode;
+        if(!ComboRando::StripPinnedFairyOcarinaHand(source->Instructions,copy->Instructions,
+            G_MARKER,G_SETTIMG_OTR_HASH,G_VTX_OTR_HASH,G_DL_OTR_HASH))return nullptr;
+        rm->CacheExternalResource("combo/runtime/fairy_ocarina_instrument",copy);
+        sFairyInstrumentSource=source;sFairyInstrumentCopy=copy;sFairyInstrumentOwner=rm;
+        if(!sFairyInstrumentListener){Ship::CrossRMRegistry::RegisterTeardownListener(Combo_DropFairyInstrument);sFairyInstrumentListener=true;}
+    }
+    // Runtime resources have no archive backing. Reinsert after cache eviction, retaining
+    // source-owned pointer payloads until registry teardown drops both references.
+    rm->CacheExternalResource("combo/runtime/fairy_ocarina_instrument",sFairyInstrumentCopy);
+    return "__OTR__@oot:combo/runtime/fairy_ocarina_instrument";
+}
+extern "C" Gfx* Combo_MM_FairyOcarinaHand(PlayState* play,Gfx* nativeHand) {
+    const char* instrument=Combo_FairyInstrumentPath();if(!instrument)return nullptr;
+    Gfx* list=(Gfx*)GRAPH_ALLOC(play->state.gfxCtx,sizeof(Gfx)*2);
+    if(!list)return nullptr;
+    Gfx* d=list;
+    gSPDisplayList(d++,nativeHand);
+    gSPBranchList(d++,(Gfx*)instrument);
+    return list; // native hand + stripped instrument, same limb matrix, no fabricated transform
+}
