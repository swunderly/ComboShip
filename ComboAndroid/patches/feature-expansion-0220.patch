+++ b/combo/rando/SpellRules.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <nlohmann/json.hpp>
+namespace ComboRando {
+struct SpellRules {
+ bool spellFireMm=false,spellLoveMm=false;
+ nlohmann::json json()const{return {{"version",1},{"spellFireMm",spellFireMm},{"spellLoveMm",spellLoveMm}};}
+};
+inline bool ReadSpellRules(const nlohmann::json& j,SpellRules& out){
+ out={};if(j.is_null())return true;
+ if(!j.is_object()||!j.contains("version")||!j["version"].is_number_integer()||j["version"]!=1)return false;
+ auto flag=[&](const char* key,bool& value){
+  if(!j.contains(key))return false;const auto& v=j[key];
+  if(v.is_boolean()){value=v.get<bool>();return true;}
+  if(!v.is_number_integer()||v<0||v>1)return false;value=v==1;return true;
+ };
+ SpellRules r;if(!flag("spellFireMm",r.spellFireMm)||!flag("spellLoveMm",r.spellLoveMm))return false;
+ out=r;return true;
+}
+inline SpellRules SpellRulesFromMmDump(const nlohmann::json& dump){
+ const auto options=dump.value("options",nlohmann::json::object());
+ auto yes=[&](const char* key){auto i=options.find(key);return i!=options.end()&&i->is_number_integer()&&*i==1;};
+ return {yes("RO_MM_SPELL_FIRE"),yes("RO_MM_SPELL_LOVE")};
+}
+namespace SpellOracle {
+// macros_common.yml can_use_din_raw / can_use_nayru_raw, MM options wrap the raw predicate.
+inline bool CanUse(bool enabled,bool magic,bool shared,bool localOwned,bool sharedOwned){
+ return enabled&&magic&&(shared?sharedOwned:localOwned);
+}
+}
+}
diff --git a/combo/rando/entrances/Context.h b/combo/rando/entrances/Context.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/Context.h
@@ -0,0 +1,76 @@
+// Native typed context for OoTMM entrance/save adapters. See LICENSE.OoTMM.
+#pragma once
+#include "Registry.h"
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <stdexcept>
+#include <variant>
+
+namespace ComboRando::Entrances {
+// Numerical values match both native engines and pinned OoTMM save layouts.
+enum class OotAge : uint8_t { Adult = 0, Child = 1 };
+enum class MmForm : uint8_t { FierceDeity = 0, Goron = 1, Zora = 2, Deku = 3, Human = 4 };
+enum class ArrivalReason : uint8_t { Entrance, Portal, Song, SaveResume, Death, Void, Farore };
+struct Key {
+    Game game = Game::Oot;
+    uint32_t id = 0; // Full logical ID; MM grotto IDs may exceed u16.
+    friend bool operator==(const Key&, const Key&) = default;
+};
+struct Position { float x = 0, y = 0, z = 0; friend bool operator==(const Position&, const Position&) = default; };
+struct OotRespawn {
+    Position pos;
+    int16_t yaw = 0, playerParams = 0;
+    uint16_t entrance = 0;
+    uint8_t roomIndex = 0;
+    int8_t data = 0;
+    uint32_t tempSwitchFlags = 0, tempCollectFlags = 0;
+};
+struct MmRespawn {
+    Position pos;
+    int16_t yaw = 0, playerParams = 0;
+    uint16_t entrance = 0;
+    uint8_t roomIndex = 0;
+    int8_t data = 0;
+    uint32_t tempSwitchFlags = 0, unk18 = 0, tempCollectFlags = 0;
+};
+static_assert(sizeof(OotRespawn) == 0x1c);
+static_assert(sizeof(MmRespawn) == 0x20);
+using Respawn = std::variant<OotRespawn, MmRespawn>;
+
+struct RespawnAnchor {
+    Key entrance; // Explicit game replaces OoTMM's overloaded high data bit.
+    Respawn nativeData;
+    OotAge age = OotAge::Child;
+    MmForm form = MmForm::Human;
+};
+struct Arrival {
+    Key destination;
+    ArrivalReason reason = ArrivalReason::Entrance;
+    OotAge age = OotAge::Child;
+    MmForm form = MmForm::Human;
+    std::optional<RespawnAnchor> dungeonIngress;
+    std::optional<RespawnAnchor> farore;
+    bool alreadyResolved = false; // Cross-game arrival must not re-enter source ER lookup.
+};
+struct SaveContexts {
+    // Optional extension only; absent in old seeds/saves means disabled.
+    std::optional<RespawnAnchor> dungeonIngress;
+    std::array<std::optional<RespawnAnchor>, 2> farore;
+    void clearDungeonIngress() { dungeonIngress.reset(); }
+};
+inline uint32_t EncodeWireId(Game source, Key destination) {
+    if (destination.id & 0x80000000u) throw std::invalid_argument("Logical ID overlaps foreign-game bit");
+    return destination.id | (source != destination.game ? 0x80000000u : 0);
+}
+inline Key DecodeWireId(Game source, uint32_t value) {
+    return {(value & 0x80000000u) ? (source == Game::Oot ? Game::Mm : Game::Oot) : source,
+            value & 0x7fffffffu};
+}
+inline bool ShouldOverride(ArrivalReason reason) {
+    return reason == ArrivalReason::Entrance || reason == ArrivalReason::Portal || reason == ArrivalReason::Song;
+}
+inline bool ShouldOverride(const Arrival& arrival) {
+    return !arrival.alreadyResolved && ShouldOverride(arrival.reason);
+}
+} // namespace ComboRando::Entrances
diff --git a/combo/rando/entrances/Format.h b/combo/rando/entrances/Format.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/Format.h
@@ -0,0 +1,107 @@
+// Optional seed extension. Missing field always uses legacy/default entrance behavior.
+#pragma once
+#include "MmWallmasterGraph.h"
+#include <nlohmann/json.hpp>
+
+namespace ComboRando::Entrances {
+inline constexpr std::string_view kMmWallmasterProfile = "mm-wallmasters-own-game-v1";
+inline Game ReadGame(const nlohmann::json& object, const char* field) {
+    const auto value = object.at(field).get<std::string>();
+    if (value == "mm") return Game::Mm;
+    if (value == "oot") return Game::Oot;
+    throw std::invalid_argument("Unknown entrance game");
+}
+inline uint32_t ReadLogicalId(const nlohmann::json& object, const char* field) {
+    const auto& value = object.at(field);
+    if (!value.is_number_integer() || (!value.is_number_unsigned() && value.get<int64_t>() < 0))
+        throw std::invalid_argument("Entrance ID must be a nonnegative integer");
+    const auto id = value.get<uint64_t>();
+    if (id >= 0x80000000ull) throw std::invalid_argument("Entrance ID exceeds logical ID range");
+    return static_cast<uint32_t>(id);
+}
+inline void CheckEnvelope(const nlohmann::json& value) {
+    if (!value.is_object() || !value.at("schemaVersion").is_number_integer() ||
+        value.at("schemaVersion") != 1 || value.at("profile").get<std::string>() != kMmWallmasterProfile ||
+        value.at("upstreamCommit").get<std::string>() != kUpstreamCommit ||
+        value.at("registrySourceSha256").get<std::string>() != kRegistrySourceSha256)
+        throw std::invalid_argument("Unsupported entrance expansion envelope");
+}
+inline nlohmann::json Envelope() {
+    return {{"schemaVersion", 1}, {"profile", kMmWallmasterProfile},
+            {"upstreamCommit", kUpstreamCommit}, {"registrySourceSha256", kRegistrySourceSha256}};
+}
+inline std::optional<std::vector<SavedOverride>> DecodeMmWallmasterSeed(const nlohmann::json& seed) {
+    if (!seed.is_object()) throw std::invalid_argument("Seed JSON is not an object");
+    if (!seed.contains("entranceExpansion")) return std::nullopt;
+    const auto& value = seed.at("entranceExpansion");
+    CheckEnvelope(value);
+    if (!value.at("overrides").is_array()) throw std::invalid_argument("Entrance override rows must be an array");
+    std::vector<SavedOverride> rows;
+    for (const auto& row : value.at("overrides")) rows.push_back({
+        row.at("source").get<std::string>(), row.at("destination").get<std::string>(),
+        ReadGame(row, "sourceGame"), ReadGame(row, "destinationGame"),
+        ReadLogicalId(row, "sourceId"), ReadLogicalId(row, "destinationId")});
+    MmWallmasterLayout verified;
+    verified.install(rows);
+    return rows;
+}
+inline nlohmann::json EncodeMmWallmasterExtension(std::span<const SavedOverride> rows) {
+    MmWallmasterLayout verified;
+    verified.install(rows);
+    auto result = Envelope();
+    result["overrides"] = nlohmann::json::array();
+    for (const auto& row : rows) result["overrides"].push_back({
+        {"source", row.source}, {"destination", row.destination},
+        {"sourceGame", row.sourceGame == Game::Oot ? "oot" : "mm"},
+        {"destinationGame", row.destinationGame == Game::Oot ? "oot" : "mm"},
+        {"sourceId", row.sourceId}, {"destinationId", row.destinationId}});
+    return result;
+}
+inline nlohmann::json EncodeMmWallmasterAssumptions(const Overrides& overrides, const Pools& remaining) {
+    // Validate the same candidate before emitting any native oracle input.
+    BuildMmWallmasterAssumptions(overrides, remaining);
+    auto result = Envelope();
+    result["overrides"] = nlohmann::json::object();
+    for (const auto& [src, dst] : overrides) result["overrides"][std::string(src)] = dst;
+    result["remainingPools"] = nlohmann::json::array();
+    for (const auto& pool : remaining) result["remainingPools"].push_back({
+        {"name", pool.name}, {"src", pool.src}, {"dst", pool.dst},
+        {"ownGame", pool.ownGame}, {"alias", pool.alias}});
+    return result;
+}
+inline MmWallmasterAssumptions DecodeMmWallmasterAssumptions(const nlohmann::json& value) {
+    CheckEnvelope(value);
+    if (!value.at("overrides").is_object() || !value.at("remainingPools").is_array())
+        throw std::invalid_argument("Invalid entrance assumption container");
+    Overrides overrides;
+    for (const auto& [srcName, dstName] : value.at("overrides").items()) {
+        const auto* src = Find(srcName); const auto* dst = Find(dstName.get<std::string>());
+        if (!src || !dst) throw std::invalid_argument("Unknown assumption entrance");
+        if (!Contains(kMmWallmasterSources, src->name) &&
+            !(src->name == "MM_CLOCK_TOWER_FROM_CLOCK_TOWN" && dst->name == "MM_CLOCK_TOWN_FROM_CLOCK_TOWER"))
+            throw std::invalid_argument("Unsupported assumption source");
+        overrides[src->name] = dst->name;
+    }
+    Pools pools;
+    for (const auto& poolJson : value.at("remainingPools")) {
+        if (!poolJson.at("src").is_array() || !poolJson.at("dst").is_array())
+            throw std::invalid_argument("Assumption pool entries must be arrays");
+        Pool pool{poolJson.at("name").get<std::string>(), {}, {},
+                  poolJson.at("ownGame").get<bool>(), poolJson.at("alias").get<bool>()};
+        for (const auto& valueSrc : poolJson.at("src")) {
+            const auto* src = Find(valueSrc.get<std::string>());
+            if (!src || !Contains(kMmWallmasterSources, src->name))
+                throw std::invalid_argument("Unsupported assumption pool source");
+            if (!pool.src.insert(src->name).second) throw std::invalid_argument("Duplicate assumption source");
+        }
+        for (const auto& valueDst : poolJson.at("dst")) {
+            const auto* dst = Find(valueDst.get<std::string>());
+            if (!dst || !MmBaseDestination(*dst, true))
+                throw std::invalid_argument("Unsupported assumption pool destination");
+            if (!pool.dst.insert(dst->name).second) throw std::invalid_argument("Duplicate assumption destination");
+        }
+        pools.push_back(std::move(pool));
+    }
+    return BuildMmWallmasterAssumptions(overrides, pools);
+}
+} // namespace ComboRando::Entrances
