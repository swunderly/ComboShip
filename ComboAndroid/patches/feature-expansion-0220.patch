+  auto& slot=Regions.at(RR_SOUTHERN_SWAMP_NEAR_FLOWERS).checks.at(check);auto legacy=slot.first;
+  slot.first=[legacy]{return TypedMmSwampActive()?NativeMmSwampPoisoned():legacy();};
+ }
+ auto moveExit=[](RandoRegionId source,RandoRegionId target,s32 entry,std::function<bool()> gate){
+  auto original=Regions.at(source).exits.at(entry);auto legacy=original.condition;
