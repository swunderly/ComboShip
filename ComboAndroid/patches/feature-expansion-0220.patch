diff --git a/combo/rando/entrances/MmOrdinaryGenerationSettings.h b/combo/rando/entrances/MmOrdinaryGenerationSettings.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmOrdinaryGenerationSettings.h
@@ -0,0 +1,14 @@
+#pragma once
+#include "rando/entrances/Shuffle.h"
+namespace ComboRando::Entrances {
+// Identical request construction for the native launcher and headless validator.
+// Admission remains in GenerateNativeMmOrdinary; unsupported eligible routes fail.
+inline Settings MmOrdinaryGenerationSettings(bool indoors,bool telescopes,bool overworld,bool dungeons) {
+ Settings settings;settings.games=Games::Mm;
+ if(indoors||telescopes)settings.erIndoors=Mode::OwnGame;
+ settings.erIndoorsTelescopes=telescopes;
+ if(overworld)settings.erOverworld=Mode::OwnGame;
+ if(dungeons)settings.erDungeons=Mode::OwnGame;
+ return settings;
+}
+}
diff --git a/combo/rando/entrances/MmOrdinaryGraph.h b/combo/rando/entrances/MmOrdinaryGraph.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmOrdinaryGraph.h
@@ -0,0 +1,45 @@
+#pragma once
+#include "MmOrdinaryLayout.h"
+#include "rando/entrances/Shuffle.h"
+#include <set>
+namespace ComboRando::Entrances {
+struct MmOrdinaryAssumptions{std::map<uint32_t,std::set<uint32_t>> routes;std::set<uint32_t> syntheticDestinations;};
+inline std::optional<MmOrdinaryAssumptions>& ActiveMmOrdinaryAssumptions(){static thread_local std::optional<MmOrdinaryAssumptions> value;return value;}
+inline MmOrdinaryAssumptions BuildMmOrdinaryAssumptions(const Overrides& overrides,const Pools& pools,const Settings& settings){
+ MmOrdinaryAssumptions result;
+ auto bind=[&](std::string_view source,std::string_view destination){auto a=Find(source),b=Find(destination);if(!a||!b||!MmOrdinaryBound(source)||!MmOrdinaryBound(destination)||a->game!=Game::Mm||b->game!=Game::Mm)throw std::invalid_argument("Unbound ordinary MM assumption");for(const auto& row:kMmOrdinaryBindings)if(row.name==source)result.routes[row.physicalId].insert(b->id);};
+ for(const auto& [src,dst]:overrides)bind(src,dst);
+ for(const auto& pool:pools){
+  // Pin solver/entrances.ts:279 and pathfind.ts:849: synthetic ASSUMED starts
+  // unconditionally at OOT SPAWN day1; its null stay expands all future MM times.
+  if(pool.src.size()*pool.dst.size()>5000 && pool.src.size()>50){
+   for(auto source:pool.src){if(!MmOrdinaryBound(source))throw std::invalid_argument("Unbound MM synthetic source");for(const auto& row:kMmOrdinaryBindings)if(row.name==source)result.routes.try_emplace(row.physicalId);}
+   for(auto destination:pool.dst){auto record=Find(destination);if(!record||!MmOrdinaryBound(destination))throw std::invalid_argument("Unbound MM synthetic arrival");result.syntheticDestinations.insert(record->id);}
+   continue;
+  }
+  for(auto source:pool.src){if(!MmOrdinaryBound(source))throw std::invalid_argument("Unbound ordinary MM source pool");for(const auto& row:kMmOrdinaryBindings)if(row.name==source)result.routes.try_emplace(row.physicalId);
+   for(auto destination:pool.dst){auto a=Find(source),b=Find(destination);if(!a||!b||!MmOrdinaryBound(destination))throw std::invalid_argument("Unbound ordinary MM destination pool");if(Assignable(*a,*b,pool.ownGame,settings))bind(source,destination);}
+  }
+ }
+ return result;
+}
+inline bool MmOrdinaryGraphOverrides(uint32_t source){if(const auto& assumed=ActiveMmOrdinaryAssumptions())if(assumed->routes.contains(CanonicalMmOrdinarySource(source)))return true;return ActiveMmOrdinary().active() && ActiveMmOrdinary().destination(source)!=source;}
+inline std::vector<uint32_t> MmOrdinaryGraphDestinations(uint32_t source){
+ if(const auto& assumed=ActiveMmOrdinaryAssumptions()){auto i=assumed->routes.find(CanonicalMmOrdinarySource(source));if(i!=assumed->routes.end())return {i->second.begin(),i->second.end()};}
+ return {ActiveMmOrdinary().destination(source)};
+}
+inline nlohmann::json EncodeMmOrdinaryAssumptions(const Overrides& overrides,const Pools& pools,const Settings& settings){
+ BuildMmOrdinaryAssumptions(overrides,pools,settings);
+ nlohmann::json value={{"schemaVersion",1},{"profile","mm-ordinary-coupled-assumptions-v1"},{"upstreamCommit",kUpstreamCommit},{"registrySha256",kRegistrySourceSha256},{"noPolarity",settings.erNoPolarity},{"selfLoops",settings.erSelfLoops},{"overrides",nlohmann::json::object()},{"remainingPools",nlohmann::json::array()}};
+ for(const auto& [src,dst]:overrides)value["overrides"][std::string(src)]=dst;
+ for(const auto& pool:pools)value["remainingPools"].push_back({{"name",pool.name},{"src",pool.src},{"dst",pool.dst},{"ownGame",pool.ownGame},{"alias",pool.alias}});
+ return value;
+}
+inline MmOrdinaryAssumptions DecodeMmOrdinaryAssumptions(const nlohmann::json& value){
+ if(!value.is_object()||value.value("schemaVersion",0)!=1||value.value("profile",std::string())!="mm-ordinary-coupled-assumptions-v1"||value.value("upstreamCommit",std::string())!=kUpstreamCommit||value.value("registrySha256",std::string())!=kRegistrySourceSha256||!value.at("noPolarity").is_boolean()||!value.at("selfLoops").is_boolean())throw std::invalid_argument("Invalid ordinary MM assumptions");
+ Settings settings;settings.games=Games::Mm;settings.erNoPolarity=value["noPolarity"];settings.erSelfLoops=value["selfLoops"];Overrides overrides;Pools pools;
+ for(const auto& [src,dst]:value.at("overrides").items()){if(!dst.is_string())throw std::invalid_argument("Invalid ordinary MM assumed target");auto a=Find(src),b=Find(dst.get<std::string>());if(!a||!b)throw std::invalid_argument("Unknown ordinary MM assumed record");overrides[a->name]=b->name;}
+ for(const auto& p:value.at("remainingPools")){Pool pool;pool.name=p.at("name").get<std::string>();pool.ownGame=p.at("ownGame").get<bool>();pool.alias=p.at("alias").get<bool>();for(const auto& v:p.at("src")){auto a=Find(v.get<std::string>());if(!a)throw std::invalid_argument("Unknown assumed source");pool.src.insert(a->name);}for(const auto& v:p.at("dst")){auto a=Find(v.get<std::string>());if(!a)throw std::invalid_argument("Unknown assumed destination");pool.dst.insert(a->name);}pools.push_back(std::move(pool));}
+ return BuildMmOrdinaryAssumptions(overrides,pools,settings);
+}
+}
diff --git a/combo/rando/entrances/MmOrdinaryLayout.h b/combo/rando/entrances/MmOrdinaryLayout.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmOrdinaryLayout.h
@@ -0,0 +1,41 @@
+#pragma once
+#include "MmOrdinaryBindings.h"
+#include "rando/entrances/Context.h"
+#include <map>
+#include <nlohmann/json.hpp>
+namespace ComboRando::Entrances {
+// Pinned Play_EntranceForOverride canonical seasonal source aliases.
+inline uint32_t CanonicalMmOrdinarySource(uint32_t entrance){
+ auto key=entrance>>9;
+ switch(key){case 0x06:key=0x42;break;case 0x57:key=0x4d;break;case 0x45:key=0x4a;break;case 0x5b:key=0x5a;break;}
+ return (key<<9)|(entrance&0x1ff);
+}
+// Saved ordinary MM routes use the actual pinned registry, never modulo/truncated IDs.
+class MmOrdinaryLayout {
+ std::map<uint32_t,uint32_t> physical;
+ nlohmann::json saved;
+public:
+ void clear(){physical.clear();saved=nlohmann::json();}
+ bool active()const{return !saved.is_null();}
+ bool containsSource(uint32_t source)const{return physical.contains(CanonicalMmOrdinarySource(source));}
+ const nlohmann::json& json()const{return saved;}
+ uint32_t destination(uint32_t source)const{auto i=physical.find(CanonicalMmOrdinarySource(source));return i==physical.end()?source:i->second;}
+ void install(const nlohmann::json& value){
+  MmOrdinaryLayout next;
+  if(!value.is_object()||value.value("schemaVersion",0)!=1||value.value("profile",std::string())!="mm-ordinary-coupled-v1"||value.value("upstreamCommit",std::string())!=kUpstreamCommit||value.value("registrySha256",std::string())!=kRegistrySourceSha256||!value.contains("overrides")||!value["overrides"].is_array())throw std::invalid_argument("Unsupported MM ordinary entrance envelope");
+  std::map<std::string,std::string> named;
+  for(const auto& row:value["overrides"]){
+   if(!row.is_object()||!row.contains("source")||!row["source"].is_string()||!row.contains("destination")||!row["destination"].is_string())throw std::invalid_argument("Malformed MM ordinary override");
+   auto src=row["source"].get<std::string>(),dst=row["destination"].get<std::string>();
+   auto a=Find(src),b=Find(dst);
+   if(!a||!b||a->game!=Game::Mm||b->game!=Game::Mm||a->id>0xffff||b->id>0xffff||!MmOrdinaryBound(src)||!MmOrdinaryBound(dst)||a->reverse.empty()||b->reverse.empty())throw std::invalid_argument("Unbound MM ordinary route");
+   if(!named.emplace(src,dst).second)throw std::invalid_argument("Duplicate ordinary source");
+   for(const auto& bind:kMmOrdinaryBindings)if(bind.name==src){auto [it,ok]=next.physical.emplace(bind.physicalId,b->id);if(!ok&&it->second!=b->id)throw std::invalid_argument("Ambiguous native MM source aliases");}
+  }
+  for(const auto& [src,dst]:named){auto a=Find(src),b=Find(dst);auto reverse=named.find(std::string(b->reverse));if(reverse==named.end()||reverse->second!=a->reverse)throw std::invalid_argument("Uncoupled MM ordinary return");}
+  next.saved=value;*this=std::move(next);
+ }
+};
+inline MmOrdinaryLayout& ActiveMmOrdinary(){static MmOrdinaryLayout value;return value;}
+}
+
diff --git a/combo/rando/entrances/MmOrdinaryNativeBridge.h b/combo/rando/entrances/MmOrdinaryNativeBridge.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmOrdinaryNativeBridge.h
@@ -0,0 +1,68 @@
+#pragma once
+#include "NativeBridge.h"
+#include "MmOrdinaryGraph.h"
+#include "MmOrdinaryAreas.h"
+namespace ComboRando::Entrances {
+inline nlohmann::json EncodeMmOrdinaryExtension(const Overrides& overrides){
+ nlohmann::json value={{"schemaVersion",1},{"profile","mm-ordinary-coupled-v1"},{"upstreamCommit",kUpstreamCommit},{"registrySha256",kRegistrySourceSha256},{"overrides",nlohmann::json::array()}};
+ for(const auto& [src,dst]:overrides)value["overrides"].push_back({{"source",src},{"destination",dst}});
+ MmOrdinaryLayout proof;proof.install(value);return value;
+}
+class MmOrdinaryAssumptionScope{
+ NativeFns native;
+public:
+ MmOrdinaryAssumptionScope(NativeFns f,const Overrides& rows,const Pools& pools,const Settings& settings):native(f){
+  if(!native.setAssumptions||!native.clearAssumptions)throw std::runtime_error("MM ordinary assumptions exports unavailable");
+  if(!native.setAssumptions(EncodeMmOrdinaryAssumptions(rows,pools,settings).dump().c_str()))throw std::runtime_error("MM ordinary assumptions rejected");
+ }
+ ~MmOrdinaryAssumptionScope(){native.clearAssumptions();}
+ MmOrdinaryAssumptionScope(const MmOrdinaryAssumptionScope&)=delete;
+};
+inline void ApplyNativeMmOrdinary(const NativeFns& native,const nlohmann::json& extension){
+ MmOrdinaryLayout proof;proof.install(extension);
+ if(!native.applySeed||!native.dumpSeed)throw std::runtime_error("MM ordinary seed exports unavailable");
+ auto current=nlohmann::json::parse(native.dumpSeed());current["ordinaryEntranceExpansion"]=extension;
+ if(!native.applySeed(current.dump().c_str()))throw std::runtime_error("MM ordinary seed rejected");
+ // An older engine must not silently ignore the new optional JSON field.
+ auto loaded=nlohmann::json::parse(native.dumpSeed());
+ if(!loaded.contains("ordinaryEntranceExpansion")||loaded["ordinaryEntranceExpansion"]!=extension)throw std::runtime_error("MM ordinary seed failed actual engine roundtrip");
+}
+// Ordinary native graph coverage must not silently shrink a requested full pool.
+// Unlike JP grotto contexts, these ordinary registry identities exist in Default US.
+inline void ValidateMmOrdinaryGenerationCoverage(const Settings& settings){
+ Types selected;for(const auto& pool:MakePools(settings)){
+  selected.insert(pool.src.begin(),pool.src.end());selected.insert(pool.dst.begin(),pool.dst.end());
+ }
+ auto require=[](const Record& record){
+  if(!MmOrdinaryBound(record.name)||
+     (record.from!="NONE"&&!MmOrdinaryNativeAreaExists(record.from))||
+     (record.to!="NONE"&&!MmOrdinaryNativeAreaExists(record.to)))
+   throw std::invalid_argument("Requested MM ordinary pool has no complete native binding: "+std::string(record.name));
+ };
+ for(const auto& record:kRegistry)if(record.game==Game::Mm&&selected.contains(record.type)){
+  require(record);if(const auto* reverse=Reverse(record))require(*reverse);
+ }
+}
+inline nlohmann::json GenerateNativeMmOrdinary(Settings settings,uint32_t seed,const NativeFns& native,
+ const std::string& ootDump,const std::string& mmDump,const std::string& forcedOot,
+ const OracleFns& oot,const OracleFns& mm,bool mmStart,CwGoal goal){
+ if(MakePools(settings).empty())return nlohmann::json();
+ if(settings.games!=Games::Mm||settings.erDecoupled||settings.erBoss!=Mode::None||settings.erWallmasters!=Mode::None||settings.erOneWays!=Mode::None||settings.erWarps!=Warps::None||settings.erSpawns!=Spawns::None)
+  throw std::invalid_argument("MM ordinary generator requires coupled MM-only ordinary pools");
+ ValidateMmOrdinaryGenerationCoverage(settings);
+ NativeScope restore(native);AssumedWorld world(ootDump,mmDump,forcedOot);
+ CwRng rng(CwHashName("entrances:mm-ordinary-coupled-v1:"+std::to_string(seed)));Bindings bindings;
+ bindings.areaExists=MmOrdinaryNativeAreaExists;
+ bindings.sourceSupported=[](const Record& record){return MmOrdinaryBound(record.name);};
+ bindings.destinationSupported=bindings.sourceSupported;
+ bindings.chooseIndex=[&](size_t count){CheckGenerationCancellation();return rng.below(static_cast<uint32_t>(count));};
+ bindings.validateAssumed=[&](const Overrides& rows,const Pools& pools){
+  const auto graph=BuildMmOrdinaryAssumptions(rows,pools,settings);
+  MmOrdinaryAssumptionScope scope(native,rows,pools,settings);
+  // Pinned OOT SPAWN is unconditional; ASSUMED permits entry without the real portal.
+  return world.validate(oot,mm,mmStart||!graph.syntheticDestinations.empty(),goal);
+ };
+ bindings.validateComplete=[&](const Overrides& rows){ApplyNativeMmOrdinary(native,EncodeMmOrdinaryExtension(rows));return world.validate(oot,mm,mmStart,goal);};
+ auto rows=Shuffler(settings,std::move(bindings)).run();return EncodeMmOrdinaryExtension(rows);
+}
+}
diff --git a/combo/rando/entrances/MmRegionalFlags.h b/combo/rando/entrances/MmRegionalFlags.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmRegionalFlags.h
@@ -0,0 +1,46 @@
+// Pin expr/data.ts CONSTRAINT_FLAGS and pathfind.ts area-domain semantics.
+#pragma once
+#include <cstdint>
+#include <functional>
+#include <stdexcept>
+namespace ComboRando::Entrances {
+struct MmFlagDomain {uint8_t on=0,off=0;};
+inline bool Valid(MmFlagDomain a){return !(a.on&a.off);}
+inline bool Covers(MmFlagDomain a,MmFlagDomain b){return (a.on&b.on)==a.on&&(a.off&b.off)==a.off;}
+inline MmFlagDomain Merge(MmFlagDomain a,MmFlagDomain b){return {uint8_t(a.on&b.on),uint8_t(a.off&b.off)};}
+inline thread_local MmFlagDomain mmFlagSource,mmFlagResult;
+inline thread_local uint8_t mmFlagAssigned=0,mmFlagAssignedMask=0,mmFlagReadMask=0;
+inline bool MmFlagOn(unsigned bit){if(bit>=8)throw std::invalid_argument("Unknown MM regional flag");const uint8_t mask=uint8_t(1u<<bit);mmFlagReadMask|=mask;return !(mmFlagAssignedMask&mask)||(mmFlagAssigned&mask);}
+inline bool MmFlagOff(unsigned bit){if(bit>=8)throw std::invalid_argument("Unknown MM regional flag");const uint8_t mask=uint8_t(1u<<bit);mmFlagReadMask|=mask;return !(mmFlagAssignedMask&mask)||!(mmFlagAssigned&mask);}
+class MmFlagScope {
+ MmFlagDomain old;public:explicit MmFlagScope(MmFlagDomain source):old(mmFlagSource){if(!Valid(source))throw std::invalid_argument("Conflicting MM regional flags");mmFlagSource=source;}
+ ~MmFlagScope(){mmFlagSource=old;} MmFlagScope(const MmFlagScope&)=delete;
+};
+struct MmFlagEvaluation{bool allowed;MmFlagDomain domain;};
+inline MmFlagEvaluation EvaluateMmFlags(const std::function<bool()>& predicate){
+ const auto priorAssigned=mmFlagAssigned,priorMask=mmFlagAssignedMask,priorRead=mmFlagReadMask;
+ struct Restore{uint8_t value,mask,reads;~Restore(){mmFlagAssigned=value;mmFlagAssignedMask=mask;mmFlagReadMask=reads;}} restore{priorAssigned,priorMask,priorRead};
+ mmFlagAssignedMask=mmFlagSource.on|mmFlagSource.off;mmFlagAssigned=mmFlagSource.on;mmFlagReadMask=0;
+ const bool first=predicate(); // Discover regional inputs even through short-circuited expressions.
+ if(!(mmFlagReadMask&~mmFlagAssignedMask)){mmFlagResult=mmFlagSource;return {first,mmFlagResult};}
+ uint8_t mask=mmFlagReadMask|mmFlagSource.on|mmFlagSource.off;
+ for(;;){
+  bool any=false;uint8_t allOn=255,allOff=255;mmFlagReadMask=0;
+  const unsigned variable=mask&~(mmFlagSource.on|mmFlagSource.off);
+  unsigned subset=variable;
+  for(;;){
+   const unsigned assignment=mmFlagSource.on|subset;
+   mmFlagAssigned=uint8_t(assignment);mmFlagAssignedMask=mask;
+   if(predicate()){any=true;allOn&=mmFlagAssigned;allOff&=uint8_t(~mmFlagAssigned);}
+   if(!subset)break;
+   subset=(subset-1)&variable;
+  }
+  const uint8_t expanded=mask|mmFlagReadMask;
+  if(expanded!=mask){mask=expanded;continue;}
+  mmFlagResult=any?MmFlagDomain{uint8_t(allOn&mask),uint8_t(allOff&mask)}:mmFlagSource;
+  return {any,mmFlagResult};
+ }
+}
+inline bool MmRegionalCursed(unsigned pair){return MmFlagOn(pair*2)&&MmFlagOff(pair*2+1);}
+inline bool MmRegionalCleared(unsigned pair,bool available){return MmFlagOn(pair*2+1)&&MmFlagOff(pair*2)&&available;}
+}
diff --git a/combo/rando/entrances/MmWallmasterGraph.h b/combo/rando/entrances/MmWallmasterGraph.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmWallmasterGraph.h
@@ -0,0 +1,70 @@
+#pragma once
+#include "Wallmasters.h"
+#include <array>
+#include <vector>
+
+namespace ComboRando::Entrances {
+struct MmWallmasterAssumptions {
+    std::array<std::vector<uint16_t>, 4> routes;
+    bool enabled = false;
+};
+// Scoped to the native oracle's thread, independent of runtime loaded layout.
+inline std::optional<MmWallmasterAssumptions>& ActiveMmWallmasterAssumptions() {
+    static thread_local std::optional<MmWallmasterAssumptions> state;
+    return state;
+}
+inline MmWallmasterAssumptions BuildMmWallmasterAssumptions(const Overrides& overrides,
+                                                           const Pools& remaining) {
+    Settings s;
+    s.games = Games::Mm; s.erWallmasters = Mode::OwnGame;
+    MmWallmasterAssumptions result;
+    result.enabled = true;
+    for (size_t i = 0; i < kMmWallmasterSources.size(); ++i) {
+        const auto src = kMmWallmasterSources[i];
+        std::set<uint16_t> destinations;
+        const auto fixed = overrides.find(src);
+        if (fixed != overrides.end()) {
+            const auto* dst = Find(fixed->second);
+            if (!dst || !MmBaseDestination(*dst)) throw std::invalid_argument("Unsupported assumed MM Wallmaster destination");
+            destinations.insert(static_cast<uint16_t>(dst->id));
+        } else {
+            for (const auto& pool : remaining) {
+                if (!pool.src.contains(src)) continue;
+                if (pool.name != "WALLMASTERS" || !pool.alias || !pool.ownGame)
+                    throw std::invalid_argument("Unsupported MM Wallmaster assumption pool");
+                for (const auto name : pool.dst) {
+                    const auto* dst = Find(name);
+                    if (!dst || !MmBaseDestination(*dst, true))
+                        throw std::invalid_argument("Unsupported assumed MM Wallmaster pool destination");
+                    if (Assignable(*Find(src), *dst, true, s)) {
+                        if (!dst->noSongOfTime || dst->id > 0xffffu)
+                            throw std::invalid_argument("Unsupported assumed MM Wallmaster arrival context");
+                        destinations.insert(static_cast<uint16_t>(dst->id));
+                    }
+                }
+            }
+        }
+        result.routes[i].assign(destinations.begin(), destinations.end());
+    }
+    return result;
+}
+class MmWallmasterAssumptionScope {
+    std::optional<MmWallmasterAssumptions> previous;
+public:
+    explicit MmWallmasterAssumptionScope(MmWallmasterAssumptions candidate)
+        : previous(std::move(ActiveMmWallmasterAssumptions())) {
+        ActiveMmWallmasterAssumptions() = std::move(candidate);
+    }
+    ~MmWallmasterAssumptionScope() { ActiveMmWallmasterAssumptions() = std::move(previous); }
+    MmWallmasterAssumptionScope(const MmWallmasterAssumptionScope&) = delete;
+    MmWallmasterAssumptionScope& operator=(const MmWallmasterAssumptionScope&) = delete;
+};
+inline std::vector<uint16_t> MmWallmasterGraphDestinations(std::string_view source) {
+    const auto i = std::find(kMmWallmasterSources.begin(), kMmWallmasterSources.end(), source);
+    if (i == kMmWallmasterSources.end()) return {};
+    const auto& assumptions = ActiveMmWallmasterAssumptions();
+    if (assumptions && assumptions->enabled) return assumptions->routes[i - kMmWallmasterSources.begin()];
+    const auto dst = ActiveMmWallmasters().destination(source);
+    return dst ? std::vector<uint16_t>{*dst} : std::vector<uint16_t>{};
+}
+} // namespace ComboRando::Entrances
diff --git a/combo/rando/entrances/NativeArrival.h b/combo/rando/entrances/NativeArrival.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/NativeArrival.h
@@ -0,0 +1,60 @@
+// In-memory handoff only; no public save ABI or engine respawn reinterpretation.
+#pragma once
+#include "rando/CrossEntrance.h"
+#include "rando/entrances/Context.h"
+#include <optional>
+namespace ComboRando::Entrances {
+struct NativeEntranceRequest {
+ int file=-1,source=-1,destination=-1,age=-1,crossAge=0;
+ uint32_t id=0;
+};
+inline bool ValidNativeEntranceRequest(const NativeEntranceRequest& r){
+ return r.file>=0&&r.file<=2&&r.source>=0&&r.source<=1&&r.destination==1-r.source&&
+  r.age>=0&&r.age<=1&&(r.crossAge==0||r.crossAge==1)&&r.id<0x80000000u;
+}
+class NativeEntranceFlight {
+ std::optional<NativeEntranceRequest> departure,arrival;
+ ComboEntrancePreflight preflight=nullptr;ComboEntranceCommit commit=nullptr;
+ bool finished=false;
+public:
+ void bridge(ComboEntrancePreflight p,ComboEntranceCommit c){cancel();preflight=p;commit=c;}
+ void cancel(){departure.reset();arrival.reset();finished=false;}
+ bool queue(const NativeEntranceRequest& r){
+  if(departure||!ValidNativeEntranceRequest(r)||!preflight||!commit||
+     !preflight(r.file,r.source,r.destination,r.id,r.age,r.crossAge))return false;
+  departure=r;return true;
+ }
+ bool arm(const NativeEntranceRequest& r,int game){
+  if(arrival||!ValidNativeEntranceRequest(r)||r.destination!=game)return false;
+  arrival=r;return true;
+ }
+ template<class Save,class Rollback> bool finish(int file,int source,Save save,Rollback rollback){
+  if(!departure)return false;
+  const auto r=*departure;departure.reset();
+  if(r.file!=file||r.source!=source||!preflight||!commit||
+     !preflight(r.file,r.source,r.destination,r.id,r.age,r.crossAge))return false;
+  // Native full-save services run before foreground mutation. A rejected
+  // callback leaves the original local transition available to the caller.
+  if(!save(r))return false;
+  if(!commit(r.file,r.source,r.destination,r.id,r.age,r.crossAge)){rollback(r);return false;}
+  finished=true;return true;
+ }
+ bool takeFinished(){bool value=finished;finished=false;return value;}
+ std::optional<NativeEntranceRequest> takeArrival(int file,int game){
+  const auto r=arrival;arrival.reset();
+  if(!r||r->file!=file||r->destination!=game)return std::nullopt;
+  return r;
+ }
+};
+// Exact pinned mm/play/play.c fixupOriginalSceneSetup. Cutscene staging belongs
+// to the destination engine and is applied before its Play_Init.
+inline uint32_t FixMmNativeArrival(uint32_t entrance,bool wf,bool sh,bool gb,bool st,int& nextCutscene){
+ uint32_t key=entrance>>9;
+ if(wf){if(key==0x42)key=0x06;else if(key==0x43)nextCutscene=0xfff0;}
+ if(sh){switch(key){case 0x4d:key=0x57;break;case 0x5a:key=0x5b;break;case 0x4a:key=0x45;break;
+  case 0x59:case 0x19:case 0x58:nextCutscene=0xfff0;break;}}
+ if(gb&&(key==0x34||key==0x35))nextCutscene=0xfff0;
+ if(st&&key==0x10)nextCutscene=0xfff0;
+ return (key<<9)|(entrance&0x1ff);
+}
+}
diff --git a/combo/rando/entrances/NativeBridge.h b/combo/rando/entrances/NativeBridge.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/NativeBridge.h
@@ -0,0 +1,161 @@
+// Shared launcher/headless adapter for the bounded native MM Wallmaster profile.
+#pragma once
+#include "Format.h"
+#include "rando/entrances/MmGrottoLayout.h"
+#include "rando/entrances/MmOrdinaryLayout.h"
+#include "rando/entrances/MmMixedLayout.h"
+#include "rando/CrossWorldRando.h"
+
+namespace ComboRando::Entrances {
+struct NativeFns {
+    int (*applySeed)(const char*) = nullptr;
+    int (*setAssumptions)(const char*) = nullptr;
+    void (*clearAssumptions)() = nullptr;
+    const char* (*dumpSeed)() = nullptr;
+};
+inline void ApplyNativeSeed(const NativeFns& native, const nlohmann::json& seed) {
+    ValidateMmMixedSeed(seed);
+    DecodeMmWallmasterSeed(seed); // reject unsupported data even with an older MM module
+    if(seed.contains("ordinaryEntranceExpansion")){MmOrdinaryLayout proof;proof.install(seed.at("ordinaryEntranceExpansion"));}
+    if(seed.contains("grottoEntranceExpansion")){MmGrottoLayout proof;proof.install(seed.at("grottoEntranceExpansion"));}
+    if (!native.applySeed) {
+        if (seed.contains("entranceExpansion")||seed.contains("ordinaryEntranceExpansion")||seed.contains("grottoEntranceExpansion")||seed.contains("mixedEntranceExpansion")) throw std::runtime_error("MM entrance expansion export unavailable");
+        return;
+    }
+    const bool expanded=seed.contains("entranceExpansion")||seed.contains("ordinaryEntranceExpansion")||seed.contains("grottoEntranceExpansion")||seed.contains("mixedEntranceExpansion");
+    if(expanded&&!native.dumpSeed)throw std::runtime_error("MM entrance expansion roundtrip export unavailable");
+    if (!native.applySeed(seed.dump().c_str())) throw std::runtime_error("MM entrance expansion seed rejected");
+    if(expanded){
+        const auto* text=native.dumpSeed();if(!text)throw std::runtime_error("MM entrance expansion roundtrip failed");
+        const auto loaded=nlohmann::json::parse(text);
+        for(const char* key:{"entranceExpansion","ordinaryEntranceExpansion","grottoEntranceExpansion","mixedEntranceExpansion"})
+            if(seed.contains(key)&&(!loaded.contains(key)||loaded.at(key)!=seed.at(key)))
+                throw std::runtime_error(std::string("MM entrance expansion ignored or changed ")+key);
+    }
+}
+class NativeScope {
+    NativeFns native;
+    std::string previous;
+public:
+    explicit NativeScope(NativeFns f) : native(f) {
+        if (native.applySeed && !native.dumpSeed) throw std::runtime_error("MM entrance snapshot export unavailable");
+        if (native.dumpSeed) {
+            const auto* value = native.dumpSeed();
+            if (!value) throw std::runtime_error("MM entrance snapshot failed");
+            previous = value;
+            DecodeMmWallmasterSeed(nlohmann::json::parse(previous));
+        }
+    }
+    ~NativeScope() {
+        if (native.clearAssumptions) native.clearAssumptions();
+        if (native.applySeed && !previous.empty()) native.applySeed(previous.c_str());
+    }
+    NativeScope(const NativeScope&) = delete;
+    NativeScope& operator=(const NativeScope&) = delete;
+};
+class AssumptionScope {
+    NativeFns native;
+public:
+    AssumptionScope(NativeFns f, const Overrides& overrides, const Pools& pools) : native(f) {
+        if (!native.setAssumptions || !native.clearAssumptions)
+            throw std::runtime_error("MM entrance assumption exports unavailable");
+        if (!native.setAssumptions(EncodeMmWallmasterAssumptions(overrides, pools).dump().c_str()))
+            throw std::runtime_error("MM entrance assumption rejected");
+    }
+    ~AssumptionScope() { native.clearAssumptions(); }
+    AssumptionScope(const AssumptionScope&) = delete;
+    AssumptionScope& operator=(const AssumptionScope&) = delete;
+};
+inline std::vector<SavedOverride> MmWallmasterRows(const Overrides& overrides) {
+    std::vector<SavedOverride> rows;
+    for (const auto name : kMmWallmasterSources) {
+        const auto it = overrides.find(name);
+        if (it == overrides.end()) throw std::runtime_error("Incomplete MM Wallmaster layout");
+        const auto* src = Find(name); const auto* dst = Find(it->second);
+        if (!src || !dst) throw std::runtime_error("Unknown MM Wallmaster route");
+        rows.push_back({std::string(src->name), std::string(dst->name), src->game, dst->game, src->id, dst->id});
+    }
+    return rows;
+}
+struct AssumedWorld {
+    std::vector<std::string> ootItems, mmItems;
+    std::set<std::string> ootChecks, mmChecks;
+    explicit AssumedWorld(const std::string& ootDump, const std::string& mmDump, const std::string& forcedOot) {
+        auto collect = [](const std::string& dump, auto& items, auto& checks) {
+            const auto data = nlohmann::json::parse(dump);
+            if (data.contains("error") || !data.contains("pool") || !data.at("pool").is_array())
+                throw std::runtime_error("Entrance validation requires a valid native item pool");
+            for (const auto& row : data.at("pool")) items.push_back(row.at("name").template get<std::string>());
+            for (const auto& row : data.value("checks", nlohmann::json::array()))
+                checks.insert(row.at("name").template get<std::string>());
+            for (const auto& row : data.value("fixed", nlohmann::json::array())) {
+                items.push_back(row.at("item").template get<std::string>());
+                checks.insert(row.at("check").template get<std::string>());
+            }
+            for (const auto& name : data.value("sharedStartingItems", std::vector<std::string>{})) items.push_back(name);
+        };
+        collect(ootDump, ootItems, ootChecks); collect(mmDump, mmItems, mmChecks);
+        if (!forcedOot.empty()) {
+            const auto forced = nlohmann::json::parse(forcedOot);
+            for (const auto& [name, row] : forced.items()) {
+                if (row.contains("item")) ootItems.push_back(row.at("item").get<std::string>());
+                ootChecks.insert(name);
+            }
+        }
+    }
+    bool validate(const OracleFns& oot, const OracleFns& mm, bool mmStart, const CwGoal& goal) const {
+        if (!oot.Reset || !oot.SetOwnedItems || !oot.GetReachableChecks || !oot.GetPortalOpen ||
+            !mm.Reset || !mm.SetOwnedItems || !mm.GetReachableChecks)
+            throw std::runtime_error("Entrance validation requires both native reachability oracles");
+        auto query = [](const OracleFns& oracle, const std::vector<std::string>& owned) {
+            CheckGenerationCancellation();
+            oracle.Reset(); oracle.SetOwnedItems(nlohmann::json(owned).dump().c_str());
+            const auto* value = oracle.GetReachableChecks();
+            if (!value) throw std::runtime_error("Native entrance oracle returned no checks");
+            const auto data = nlohmann::json::parse(value);
+            if (!data.is_array()) throw std::runtime_error("Native entrance oracle returned malformed checks");
+            std::unordered_set<std::string> result;
+            for (const auto& name : data) result.insert(name.get<std::string>());
+            return result;
+        };
+        bool mmOpen = mmStart;
+        const auto reached = QuerySongWorlds(oot, mm, ootItems, mmItems, mmOpen, query);
+        for (const auto& name : ootChecks) if (!reached.first.contains(name)) return false;
+        for (const auto& name : mmChecks) if (!reached.second.contains(name)) return false;
+        return CwGoalReached(goal, reached.first.contains("Ganon"), reached.second.contains("Defeat Majora"), ootItems, mmItems);
+    }
+};
+// The real combined fill still runs AFTER this assumed-inventory placement phase;
+// it certifies the saved item progression under the original accessibility policy.
+inline nlohmann::json GenerateNativeMmWallmasters(bool enabled, uint32_t seed, const NativeFns& native,
+    const std::string& ootDump, const std::string& mmDump, const std::string& forcedOot,
+    const OracleFns& oot, const OracleFns& mm, bool mmStart, CwGoal goal) {
+    ApplyNativeSeed(native, nlohmann::json::object());
+    if (!enabled) return nlohmann::json(); // no pool construction or new RNG on legacy seeds
+    if (!native.applySeed || !native.dumpSeed || !native.setAssumptions || !native.clearAssumptions)
+        throw std::runtime_error("Native MM Wallmaster generation exports unavailable");
+    AssumedWorld world(ootDump, mmDump, forcedOot);
+    Settings settings; settings.games = Games::Mm; settings.erWallmasters = Mode::OwnGame;
+    CwRng rng(CwHashName("entrances:mm-wallmasters-own-game-v1:" + std::to_string(seed)));
+    Bindings bindings;
+    bindings.areaExists = [](std::string_view area) {
+        for (const auto& record : kRegistry)
+            if ((Contains(kMmWallmasterSources, record.name) || MmBaseDestination(record, true)) &&
+                (record.from == area || record.to == area)) return true;
+        return false;
+    };
+    bindings.sourceSupported = [](const Record& record) { return Contains(kMmWallmasterSources, record.name); };
+    bindings.destinationSupported = [](const Record& record) { return MmBaseDestination(record, true); };
+    bindings.chooseIndex = [&](size_t count) { CheckGenerationCancellation(); return rng.below(static_cast<uint32_t>(count)); };
+    bindings.validateAssumed = [&](const Overrides& rows, const Pools& pools) {
+        AssumptionScope scope(native, rows, pools);
+        return world.validate(oot, mm, mmStart, goal);
+    };
+    bindings.validateComplete = [&](const Overrides& rows) {
+        ApplyNativeSeed(native, {{"entranceExpansion", EncodeMmWallmasterExtension(MmWallmasterRows(rows))}});
+        return world.validate(oot, mm, mmStart, goal);
+    };
+    const auto rows = Shuffler(settings, std::move(bindings)).run();
+    return EncodeMmWallmasterExtension(MmWallmasterRows(rows));
+}
+} // namespace ComboRando::Entrances
diff --git a/combo/rando/entrances/NativeSceneArrival.h b/combo/rando/entrances/NativeSceneArrival.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/NativeSceneArrival.h
@@ -0,0 +1,67 @@
+// Included after the owning engine's typed Scene/scene-command headers.
+// Scene deliberately has no raw payload pointer; validate typed commands instead.
+#pragma once
+#include <ship/resource/ResourceManager.h>
+#include <memory>
+#include <string>
+namespace ComboRando::Entrances {
+struct NativeSceneSelection {
+ std::shared_ptr<SOH::SetEntranceList> entrances;
+ std::shared_ptr<SOH::SetStartPositionList> starts;
+ std::shared_ptr<SOH::SetRoomList> rooms;
+};
+inline bool NativeSceneMetadata(const std::shared_ptr<SOH::Scene>& scene) {
+ return scene&&!scene->IsDirty()&&scene->GetInitData()&&
+  scene->GetInitData()->Type==0x4f524f4d&& !scene->commands.empty();
+}
+inline bool SelectNativeSceneCommands(const std::shared_ptr<SOH::Scene>& scene,int layer,
+ bool ootAdultNightFallback,NativeSceneSelection& selection,unsigned depth=0) {
+ if(!NativeSceneMetadata(scene)||layer<0||depth>16)return false;
+ for(const auto& command:scene->commands) {
+  if(!command)return false;
+  switch(command->cmdId) {
+   case SOH::SceneCommandID::SetEntranceList:
+    selection.entrances=std::dynamic_pointer_cast<SOH::SetEntranceList>(command);
+    if(!selection.entrances)return false;break;
+   case SOH::SceneCommandID::SetStartPositionList:
+    selection.starts=std::dynamic_pointer_cast<SOH::SetStartPositionList>(command);
+    if(!selection.starts)return false;break;
+   case SOH::SceneCommandID::SetRoomList:
+    selection.rooms=std::dynamic_pointer_cast<SOH::SetRoomList>(command);
+    if(!selection.rooms)return false;break;
+   case SOH::SceneCommandID::SetAlternateHeaders: {
+    const auto headers=std::dynamic_pointer_cast<SOH::SetAlternateHeaders>(command);
+    if(!headers||headers->numHeaders!=headers->headers.size())return false;
+    if(!layer)break;
+    if(static_cast<size_t>(layer)>headers->headers.size())return false;
+    auto desired=headers->headers[layer-1];
+    // Exact native OoT fallback: absent adult-night header uses adult-day.
+    if(!desired&&ootAdultNightFallback&&layer==3)desired=headers->headers[1];
+    if(desired)return SelectNativeSceneCommands(desired,layer,ootAdultNightFallback,selection,depth+1);
+    break;
+   }
+   case SOH::SceneCommandID::EndMarker:return true;
+   default:break;
+  }
+ }
+ return true;
+}
+inline bool ValidateOwnedNativeSpawn(const std::shared_ptr<Ship::ResourceManager>& owner,
+ const std::string& path,int layer,int spawn,int respawnRoom,bool ootAdultNightFallback) {
+ if(!owner||path.empty()||spawn<0)return false;
+ try {
+  const auto scene=std::dynamic_pointer_cast<SOH::Scene>(owner->LoadResource(path));
+  NativeSceneSelection selection;
+  if(!SelectNativeSceneCommands(scene,layer,ootAdultNightFallback,selection)||
+     !selection.entrances||!selection.starts||!selection.rooms)return false;
+  const auto& entries=*selection.entrances;const auto& starts=*selection.starts;const auto& rooms=*selection.rooms;
+  if(entries.numEntrances!=entries.entrances.size()||starts.numStartPositions!=starts.startPositions.size()||
+     rooms.numRooms!=rooms.rooms.size()||rooms.numRooms!=rooms.fileNames.size()||
+     static_cast<size_t>(spawn)>=entries.entrances.size())return false;
+  const auto& entrance=entries.entrances[spawn];
+  const int room=respawnRoom>=0?respawnRoom:entrance.room;
+  if(entrance.spawn>=starts.startPositions.size()||room<0||static_cast<size_t>(room)>=rooms.fileNames.size())return false;
+  return NativeSceneMetadata(std::dynamic_pointer_cast<SOH::Scene>(owner->LoadResource(rooms.fileNames[room])));
+ } catch(...) {return false;}
+}
+}
