+ Regions.at(RR_MM_SWAMP_WATER_WITCH).checks.insert(CHECK(RC_SOUTHERN_SWAMP_POISON_BEEHIVE,TypedMmSwampActive()&&NativeMmSwampPoisoned()&&RANDO_EVENTS[RE_MM_SWAMP_HIVE]&&MmSwampSwimOrTallOrGoron()));
