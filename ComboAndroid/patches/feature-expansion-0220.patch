diff --git a/mm/2s2h/Rando/ActorBehavior/MissingMmSouls.h b/mm/2s2h/Rando/ActorBehavior/MissingMmSouls.h
new file mode 100644
--- /dev/null
+++ b/mm/2s2h/Rando/ActorBehavior/MissingMmSouls.h
@@ -0,0 +1,49 @@
+#pragma once
+#include "Rando/Rando.h"
+#include <algorithm>
+#include "MissingMmSoulsState.h"
+namespace Rando {
+inline constexpr RandoItemId missingMmSoulItems[]={RI_SOUL_BOSS_IGOS,RI_SOUL_ENEMY_BIO_BABA,
+    RI_SOUL_ENEMY_FLOORMASTER,RI_SOUL_ENEMY_FLYING_POT,RI_SOUL_ENEMY_REAL_BOMBCHU,RI_SOUL_ENEMY_SKULLWALLTULA};
+inline int MissingMmSoulIndex(RandoItemId item) {
+    for(unsigned i=0;i<6;++i) if(missingMmSoulItems[i]==item) return i;
+    return -1;
+}
+// Exact pinned mm/actors.c identity split, including gold-vs-wall Skulltulas.
+inline int MissingMmSoulForActor(int actor,unsigned params) {
+    switch(actor) {
+    case ACTOR_EN_KNIGHT: case ACTOR_BOSS_06:return 0;
+    case ACTOR_BOSS_05:return 1;
+    case ACTOR_EN_FLOORMAS:return 2;
+    case ACTOR_EN_TUBO_TRAP:return 3;
+    case ACTOR_EN_RAT:return 4;
+    case ACTOR_EN_SW:return (params&3) ? -1 : 5;
+    default:return -1;
+    }
+}
+inline int EvaluateMissingMmSoulPreSpawn(int actor,unsigned params,bool enabled,bool credits,bool boss,bool enemies,uint8_t owned) {
+    if(!enabled || credits) return 1;
+    const int index=MissingMmSoulForActor(actor,params);
+    if(index<0 || !(index ? enemies : boss) || MissingMmSoulOwned(owned,index)) return 1;
+    return index==3 ? -1 : 0;
+}
+
+template<class Options> inline bool MissingMmSoulShuffled(const Options& options,unsigned index) {
+    return index<6 && options[RO_MM_COMPLETE_SOULS] && options[index ? RO_SHUFFLE_ENEMY_SOULS : RO_SHUFFLE_BOSS_SOULS];
+}
+template<class Options> inline void AddMissingMmSoulPool(const Options& options,std::vector<RandoItemId>& pool) {
+    if(!options[RO_MM_COMPLETE_SOULS]) return;
+    // Preserve the old item ID, but new seeds classify Igos in the boss family.
+    pool.erase(std::remove(pool.begin(),pool.end(),RI_SOUL_ENEMY_IGOS_DU_IKANA),pool.end());
+    for(unsigned i=0;i<6;++i) if(MissingMmSoulShuffled(options,i)) pool.push_back(missingMmSoulItems[i]);
+}
+template<class Options> inline void AddUnshuffledMissingMmSouls(const Options& options,std::vector<RandoItemId>& starts) {
+    if(!options[RO_MM_COMPLETE_SOULS]) return;
+    // New seeds use the boss identity; legacy seeds retain their old starter unchanged.
+    starts.erase(std::remove(starts.begin(),starts.end(),RI_SOUL_ENEMY_IGOS_DU_IKANA),starts.end());
+    for(unsigned i=0;i<6;++i) if(!MissingMmSoulShuffled(options,i)) starts.push_back(missingMmSoulItems[i]);
+}
+bool HaveMissingMmSoul(unsigned index);
+bool GrantMissingMmSoul(RandoItemId item);
+bool RemoveMissingMmSoul(RandoItemId item);
+}
diff --git a/mm/2s2h/Rando/ActorBehavior/MissingMmSoulsState.h b/mm/2s2h/Rando/ActorBehavior/MissingMmSoulsState.h
new file mode 100644
--- /dev/null
+++ b/mm/2s2h/Rando/ActorBehavior/MissingMmSoulsState.h
@@ -0,0 +1,32 @@
+#pragma once
+#include <cstdint>
+#include <stdexcept>
+#include <nlohmann/json.hpp>
+namespace Rando {
+inline constexpr unsigned MissingMmSoulCount=6;
+inline bool MissingMmSoulOwned(uint8_t owned,unsigned index) { return index<6 && (owned&(1u<<index)); }
+inline bool ChangeMissingMmSoul(uint8_t& owned,unsigned index,bool grant) {
+    if(index>=6) return false;
+    if(grant) owned|=1u<<index; else owned&=~(1u<<index);
+    return true;
+}
+inline uint8_t RestoreMissingMmSouls(const nlohmann::json& saved) {
+    if(!saved.contains("mmMissingSoulsOwned")) return 0;
+    const auto& value=saved.at("mmMissingSoulsOwned");
+    if(!value.is_number_integer()) throw std::runtime_error("Invalid MM missing soul ownership type");
+    const auto bits=value.get<int64_t>();
+    if(bits<0 || bits>63) throw std::runtime_error("Invalid MM missing soul ownership bits");
+    return static_cast<uint8_t>(bits);
+}
+// PlayState identity and room are scoped runtime state, never persistent save data.
+struct MissingSoulRoomGuard {
+    const void* play=nullptr; int room=-1; bool blocked=false;
+    void reset(const void* current,int currentRoom) {play=current;room=currentRoom;blocked=false;}
+    void deny(const void* current,int currentRoom,int spawnResult) {
+        if(spawnResult!=0) return;
+        if(play!=current || room!=currentRoom) reset(current,currentRoom);
+        blocked=true;
+    }
+    bool canClear(const void* current,int currentRoom) const {return !(blocked && play==current && room==currentRoom);}
+};
+}
