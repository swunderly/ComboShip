+  if(ComboRando::Entrances::ActiveMmOrdinary().containsSource(record.id))return true;
+  if(const auto& assumed=ComboRando::Entrances::ActiveMmOrdinaryAssumptions();assumed&&assumed->routes.contains(record.id))return true;
+ }
