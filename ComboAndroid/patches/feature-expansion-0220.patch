+ for(auto source:old)for(auto& [target,condition]:Regions.at(source).connections)if(old.contains(target)){
+  auto original=condition.first;condition.first=[original]{return !TypedMmSwampActive()&&original();};
+ }
+ for(auto id:{RR_MM_SWAMP_WATER_TOURIST,RR_MM_SWAMP_WATER_WITCH,RR_MM_SWAMP_WATER_FROG,RR_MM_SWAMP_WATER_PALACE,RR_MM_SWAMP_WATER_SPIDER,RR_MM_SWAMP_NEAR_FROG,RR_MM_SWAMP_NEAR_SPIDER,RR_MM_GROTTO_SWAMP_LEDGE,RR_MM_SWAMP_CANOPY_FRONT,RR_MM_SWAMP_BOAT_RIDE})
+  Regions[id]=RandoRegion{.name="Pinned Swamp approach",.sceneId=SCENE_20SICHITAI};
+ auto edge=[](RandoRegionId source,RandoRegionId target,std::function<bool()> gate){
+  auto& connections=Regions.at(source).connections;auto found=connections.find(target);
+  if(found==connections.end())connections.emplace(target,std::make_pair(std::function<bool()>([gate]{return TypedMmSwampActive()&&gate();}),std::string("Pinned Swamp context")));
+  else {auto legacy=found->second.first;found->second.first=[legacy,gate]{return legacy()||(TypedMmSwampActive()&&gate());};}
+ };
+ // Native wide sections become exact pinned dry regions; water routes have their own frontier.
+ edge(RR_SOUTHERN_SWAMP_NORTH,RR_MM_SWAMP_WATER_TOURIST,[]{return MmSwampSwimOrTallOrGoron();});
+ edge(RR_SOUTHERN_SWAMP_NORTH,RR_SOUTHERN_SWAMP_NEAR_WOODS,[]{return CAN_BE_DEKU;});
+ edge(RR_MM_SWAMP_WATER_TOURIST,RR_SOUTHERN_SWAMP_NORTH,[]{return true;});
+ edge(RR_MM_SWAMP_WATER_TOURIST,RR_MM_SWAMP_WATER_WITCH,[]{return true;});
+ edge(RR_MM_SWAMP_WATER_TOURIST,RR_MM_SWAMP_WATER_SPIDER,[]{return (NativeMmSwampCleared()||RANDO_EVENTS[RE_MM_SWAMP_OCTO_RIGHT])&&MmSwampCrossPoison();});
+ edge(RR_MM_SWAMP_WATER_WITCH,RR_SOUTHERN_SWAMP_NEAR_WOODS,[]{return MmSwampSwimOrTallOrGoron();});
+ edge(RR_MM_SWAMP_WATER_WITCH,RR_MM_SWAMP_WATER_TOURIST,[]{return true;});
+ edge(RR_MM_SWAMP_WATER_WITCH,RR_MM_SWAMP_WATER_FROG,[]{return MmSwampSwimOrTallOrGoron();});
+ edge(RR_MM_SWAMP_WATER_FROG,RR_MM_SWAMP_NEAR_FROG,[]{return MmSwampCanSwim()||CAN_BE_ZORA;});
+ edge(RR_MM_SWAMP_WATER_FROG,RR_SOUTHERN_SWAMP_NEAR_FLOWERS,[]{return CAN_BE_ZORA;});
+ edge(RR_MM_SWAMP_WATER_FROG,RR_MM_SWAMP_WATER_WITCH,[]{return MmSwampSwimOrTallOrGoron();});
+ edge(RR_MM_SWAMP_WATER_FROG,RR_MM_SWAMP_WATER_PALACE,[]{return (NativeMmSwampCleared()||RANDO_EVENTS[RE_MM_SWAMP_OCTO_LEFT])&&MmSwampCrossPoison();});
+ edge(RR_MM_SWAMP_WATER_PALACE,RR_MM_SWAMP_WATER_FROG,[]{return (NativeMmSwampCleared()||RANDO_EVENTS[RE_MM_SWAMP_OCTO_LEFT])&&MmSwampCrossPoison();});
+ edge(RR_MM_SWAMP_WATER_PALACE,RR_MM_SWAMP_WATER_SPIDER,[]{return MmSwampCrossPoison();});
+ edge(RR_MM_SWAMP_WATER_PALACE,RR_SOUTHERN_SWAMP_SOUTH,[]{return CAN_BE_ZORA||(MmSwampCanSwim()&&CAN_USE_NAYRUS_LOVE)||(CAN_BE_GORON&&CAN_BE_DEKU)||(NativeMmSwampCleared()&&(MmSwampCanSwim()||CAN_BE_GORON));});
+ edge(RR_MM_SWAMP_WATER_SPIDER,RR_MM_SWAMP_WATER_PALACE,[]{return MmSwampCrossPoison();});
