+void DropSpellResources(){ComboRando::ComboFaroreIntegrationReady=false;sOwners={};sFrameOwners={};sOotResources={};sMmResources={};auto invalidate=sInvalidateIntegration;sInvalidateIntegration=nullptr;if(invalidate)invalidate();}
+}
+extern "C" int Combo_MMSpellEffectiveHumanAge(){return Combo_MMFaroreEffectiveHumanAge();}
+extern "C" int Combo_MMSpellEnabled(int spell){
+ if(!ComboRando::ComboFaroreIntegrationReady)return 0;
+ const auto& state=gSaveContext.save.shipSaveInfo;
+ if(gSaveContext.fileNum<0||gSaveContext.fileNum>2||state.saveType!=SAVETYPE_RANDO)return 0;
+ if(spell==1)return state.rando.randoSaveOptions[RO_MM_SPELL_LOVE]&&state.spellLoveOwned;
+ if(spell==2)return state.rando.randoSaveOptions[RO_MM_SPELL_FIRE]&&state.spellFireOwned;
+ return 0;
+}
+extern "C" void Combo_MMSpellGrantItem(int spell){
+ if(spell!=1&&spell!=2)return;
+ auto& state=gSaveContext.save.shipSaveInfo;
+ if(spell==1)state.spellLoveOwned=1;else state.spellFireOwned=1;
+ auto& slot=gSaveContext.save.saveInfo.inventory.items[spell==1?SLOT_TRADE_COUPLE:SLOT_TRADE_DEED];
+ if(slot==ITEM_NONE)slot=spell==1?ITEM_COMBO_NAYRUS_LOVE:ITEM_COMBO_DINS_FIRE;
+}
+extern "C" int Combo_MMSpellPrepareResources(int spell){
+ if(spell!=1&&spell!=2)return 0;
+ try {
+  const size_t index=spell-1,count=spell==1?12u:10u;
+  auto oot=Ship::CrossRMRegistry::Get("oot"),mm=Ship::CrossRMRegistry::Get("mm");if(!oot||!mm)return 0;
+  bool cached=sOwners[index][0]&&sOotResources[index]==oot&&sMmResources[index]==mm&&sOotAlt[index]==oot->IsAltAssetsEnabled()&&sMmAlt[index]==mm->IsAltAssetsEnabled();
+  for(size_t i=0;cached&&i<count;++i)cached=ComboNativeSpells::Valid(sOwners[index][i],sPaths[index][i],sFrameOwners[index][i]);
+  if(cached)return 1;
+  std::array<std::shared_ptr<Ship::IResource>,12> owners,frames;
+  for(size_t i=0;i<count;++i){
+   owners[i]=ComboNativeSpells::Load((i>=1&&i<=4)||i>=10?mm:oot,sPaths[index][i],frames[i]);if(!owners[i])return 0;
+  }
+  sOotAlt[index]=oot->IsAltAssetsEnabled();sMmAlt[index]=mm->IsAltAssetsEnabled();
+  sOwners[index]=std::move(owners);sFrameOwners[index]=std::move(frames);sOotResources[index]=std::move(oot);sMmResources[index]=std::move(mm);
+  Ship::CrossRMRegistry::RegisterTeardownListener(DropSpellResources);return 1;
+ }catch(const std::exception&){return 0;}
+}
+// Private exact-candidate preflight; does not grant items, cast, or change a save.
+// Bit0 Wind, bit1 Love, bit2 Fire. Both engines must have their real RMs registered.
+extern "C" COMBO_EXPORT int MM_PrepareNativeSpellsForCombo() {
+ int mask=0;
+ if(Combo_MMFarorePrepareResources())mask|=1;
+ if(Combo_MMSpellPrepareResources(1))mask|=2;
+ if(Combo_MMSpellPrepareResources(2))mask|=4;
+ return mask;
+}
+// Process startup/teardown only. Save rules and actual ownership remain independent.
+extern "C" COMBO_EXPORT int MM_SetNativeSpellIntegrationReady(int enable,void (*invalidate)()) {
+ ComboRando::ComboFaroreIntegrationReady=false;sInvalidateIntegration=enable?invalidate:nullptr;
+ if(enable&&Combo_MMFaroreBridgeReady()&&MM_PrepareNativeSpellsForCombo()==7)ComboRando::ComboFaroreIntegrationReady=true;
+ return ComboRando::ComboFaroreIntegrationReady?1:0;
+}
+extern "C" const char* Combo_MMSpellItemName(int item){
+ const int spell=item==ITEM_COMBO_NAYRUS_LOVE?1:item==ITEM_COMBO_DINS_FIRE?2:0;
+ if(!spell||!Combo_MMSpellPrepareResources(spell))return sComboEmptyItemName;
+ return spell==1?sComboLoveItemName:sComboFireItemName;
+}
+#endif
