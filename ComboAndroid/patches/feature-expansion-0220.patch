+ auto& frog=Regions.at(RR_SOUTHERN_SWAMP_NEAR_FLOWERS).checks.at(RC_SOUTHERN_SWAMP_FROG);auto originalFrog=frog.first;
+ frog.first=[originalFrog]{return !TypedMmSwampActive()&&originalFrog();};
