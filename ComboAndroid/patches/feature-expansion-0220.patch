diff --git a/combo/rando/NativeConfinedSongPreparation.h b/combo/rando/NativeConfinedSongPreparation.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/NativeConfinedSongPreparation.h
@@ -0,0 +1,19 @@
+#pragma once
+#include "rando/SongTravel.h"
+namespace ComboRando {
+// Confined placement is native-only pool preparation, before combined oracle fill.
+// A mixed-song exit cannot be traversed here: the other world's oracle is absent.
+// Prepare restricted placements with the native graph, then restore the exact seed
+// map before combined fill and its original-rule every-check certification.
+class NativeConfinedSongPreparation {
+    SongTravelMap saved;
+public:
+    NativeConfinedSongPreparation() : saved(ActiveSongTravel()) {
+        ActiveSongTravel().logicEnabled = false;
+        ActiveSongTravel().logicForeignSongs = false;
+    }
+    ~NativeConfinedSongPreparation() { ActiveSongTravel() = saved; }
+    NativeConfinedSongPreparation(const NativeConfinedSongPreparation&) = delete;
+    NativeConfinedSongPreparation& operator=(const NativeConfinedSongPreparation&) = delete;
+};
+}
diff --git a/combo/rando/NativeFaroreArrivalAdapter.h b/combo/rando/NativeFaroreArrivalAdapter.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/NativeFaroreArrivalAdapter.h
@@ -0,0 +1,57 @@
+#pragma once
+
+// Adapted from OoTMM oot/play/play.c and mm/play/play.c, MIT revision
+// 41a2b7c0d7dbbb53fed928652f8271bc336c113f. See OoTMM-MIT-LICENSE.txt.
+// Isolated field-restoration adapters only. The engine bridge must perform its
+// age change first, then supply that age's typed point and respawn backups.
+// Respawn arguments share one engine type: no cross-engine byte copying.
+namespace ComboFarore {
+
+template<class Point, class Respawn, class Flag, class SpawnMarker>
+void RestoreNativeOotArrival(const Point& point, const Respawn& dungeonBackup,
+                             Respawn& top, Respawn& dungeon,
+                             Flag& respawnFlag, SpawnMarker& isFwSpawn) {
+    if (!isFwSpawn) return;
+    respawnFlag = 3;
+    isFwSpawn = 0;
+    dungeon = dungeonBackup;
+    // This is the pinned arrival truth test, not the > 0 destination test.
+    if (point.set) {
+        top.data = 0x28;
+        top.pos.x = static_cast<decltype(top.pos.x)>(point.pos.x);
+        top.pos.y = static_cast<decltype(top.pos.y)>(point.pos.y);
+        top.pos.z = static_cast<decltype(top.pos.z)>(point.pos.z);
+        top.yaw = static_cast<decltype(top.yaw)>(point.yaw);
+        top.playerParams = static_cast<decltype(top.playerParams)>(point.playerParams);
+        top.entranceIndex = static_cast<decltype(top.entranceIndex)>(point.entranceIndex);
+        top.roomIndex = static_cast<decltype(top.roomIndex)>(point.roomIndex);
+        top.tempSwchFlags = static_cast<decltype(top.tempSwchFlags)>(point.tempSwchFlags);
+        top.tempCollectFlags = static_cast<decltype(top.tempCollectFlags)>(point.tempCollectFlags);
+    } else {
+        top.data = 0;
+        top.pos.x = 0.0f;
+        top.pos.y = 0.0f;
+        top.pos.z = 0.0f;
+    }
+}
+
+template<class Respawn, class Flag, class SpawnMarker>
+void RestoreNativeMmArrival(const Respawn& point, const Respawn& topBackup,
+                            const Respawn& dungeonBackup, Respawn& human,
+                            Respawn& top, Respawn& dungeon,
+                            Flag& respawnFlag, SpawnMarker& isFwSpawn) {
+    if (!isFwSpawn) return;
+    respawnFlag = 8;
+    top = topBackup;
+    dungeon = dungeonBackup;
+    // MM leaves isFwSpawn unchanged in this pinned branch.
+    if (point.data) {
+        human = point;
+    } else {
+        human.data = 0;
+        human.pos.x = 0.0f;
+        human.pos.y = 0.0f;
+        human.pos.z = 0.0f;
+    }
+}
+}
