+inline std::vector<std::string> NumOpts(const int min,const int max,const int step=1,const std::string& textBefore={},const std::string& textAfter={}) {
+    std::vector<std::string> options;
+    options.reserve((max - min) / step + 1);
+    for (int i = min; i <= max; i += step) {
+        options.push_back(textBefore + std::to_string(i) += textAfter);
+    }
+    return options;
+}
+struct Option {
+ std::function<int()> current;std::function<void(int)> update;
+ std::string key,disabledText;bool hidden=false,disabled=false;std::vector<std::string> choices;
+ void Hide(){hidden=true;}void Unhide(){hidden=false;}bool IsHidden()const{return hidden;}
+ void Disable(const char* text){disabled=true;disabledText=text;}void Enable(){disabled=false;disabledText.clear();}
+ void AddFlag(int){}void RemoveFlag(int){}size_t GetOptionCount()const{return choices.size();}
+ void ChangeOptions(std::vector<std::string> values){if(current&&update&&current()>=int(values.size()))update(static_cast<uint8_t>(values.size()-1));choices=std::move(values);}
+};
