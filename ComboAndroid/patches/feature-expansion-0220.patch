+inline bool TypedMmGrottoSourceActive(uint32_t id){return ComboRando::Entrances::MmMixedGraphOverrides(id)||ComboRando::Entrances::ActiveMmMixedAssumptions().has_value()||ComboRando::Entrances::ActiveMmMixed().active()||ComboRando::Entrances::MmGrottoGraphOverrides({ComboRando::Entrances::Game::Mm,id})||ComboRando::Entrances::ActiveMmOrdinary().active()||ComboRando::Entrances::ActiveMmOrdinaryAssumptions().has_value();}
+inline bool NativeMmOverworldShuffled(){
+ for(const auto& record:ComboRando::Entrances::kRegistry)if(record.game==ComboRando::Entrances::Game::Mm&&record.type==ComboRando::Entrances::Type::Overworld){
+  if(ComboRando::Entrances::MmMixedGraphOverrides(record.id))return true;
+  if(ComboRando::Entrances::ActiveMmOrdinary().containsSource(record.id))return true;
+  if(const auto& assumed=ComboRando::Entrances::ActiveMmOrdinaryAssumptions();assumed&&assumed->routes.contains(record.id))return true;
+ }
+ return false;
+}
