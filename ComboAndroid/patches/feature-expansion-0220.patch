+// OoTMM 41a2b7c0: data/world/mm/overworld/southern_swamp.yml.
+// Unsupported MM boots/adult/anywhere-hook extensions are not capabilities of this engine slice.
+inline bool TypedMmSwampActive(){return TypedMmGrottoSourceActive(65540u);}
+inline bool MmSwampCanSwim(){return CAN_USE_ABILITY(SWIM)||CAN_BE_ZORA;}
