@@ -0,0 +1,25 @@
+// Native MM RespawnData adapter for pinned OoTMM typed grotto contexts.
+// Isolated continuation; no public/runtime activation. See LICENSE.OoTMM.
+#pragma once
+#include "rando/entrances/MmGrottos.h"
+namespace ComboRando::Entrances {
+template<class Native> MmRespawn ReadNativeMmRespawn(const Native& n) {
+ return {{n.pos.x,n.pos.y,n.pos.z},n.yaw,n.playerParams,n.entrance,n.roomIndex,n.data,n.tempSwitchFlags,n.unk_18,n.tempCollectFlags};
+}
+template<class Native> void WriteNativeMmRespawn(Native& n,const MmRespawn& r) {
+ n.pos.x=r.pos.x;n.pos.y=r.pos.y;n.pos.z=r.pos.z;n.yaw=r.yaw;n.playerParams=r.playerParams;n.entrance=r.entrance;n.roomIndex=r.roomIndex;n.data=r.data;n.tempSwitchFlags=r.tempSwitchFlags;n.unk_18=r.unk18;n.tempCollectFlags=r.tempCollectFlags;
+}
+template<class Native> MmGrottoContext ReadNativeMmGrotto(const Native* slots,MmPreviousScene previous,int32_t flag,bool cleared) {
+ MmGrottoContext c;for(size_t i=0;i<4;++i)c.respawn[i]=ReadNativeMmRespawn(slots[i]);c.previousScene=previous;c.respawnFlag=flag;c.snowheadCleared=cleared;return c;
+}
+// Resolve full uint32 logical identity before any native u16 conversion.
+// Invalid/foreign extended identities throw before modifying native slots.
+template<class Native> uint16_t ApplyNativeMmGrotto(Key arrival,Native* slots,MmPreviousScene& previous,int32_t& flag,bool cleared) {
+ auto c=ReadNativeMmGrotto(slots,previous,flag,cleared);
+ const auto native=ApplyMmCustomEntrance(arrival,c);
+ if(native.game!=Game::Mm||native.id>0xffffu)throw std::invalid_argument("Unrepresentable MM native grotto destination");
+ for(size_t i=0;i<4;++i)WriteNativeMmRespawn(slots[i],c.respawn[i]);previous=c.previousScene;flag=c.respawnFlag;
+ return static_cast<uint16_t>(native.id);
+}
+}
+
diff --git a/combo/rando/entrances/MmGrottoNativeBridge.h b/combo/rando/entrances/MmGrottoNativeBridge.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmGrottoNativeBridge.h
@@ -0,0 +1,64 @@
+// Real full-pool MM generation. Public capability stays gated pending runtime proof.
+#pragma once
+#include "rando/entrances/NativeBridge.h"
+#include "rando/entrances/MmGrottoGraph.h"
+#include "rando/entrances/MmOrdinaryAreas.h"
+namespace ComboRando::Entrances {
+inline nlohmann::json EncodeMmGrottoExtension(const Overrides& rows,bool noPolarity=false){
+ nlohmann::json value={{"schemaVersion",1},{"profile","mm-grotto-coupled-v1"},{"upstreamCommit",kUpstreamCommit},{"registrySha256",kRegistrySourceSha256},{"noPolarity",noPolarity},{"overrides",nlohmann::json::array()}};
+ for(const auto& [src,dst]:rows){
+  if(IsMmGrottoClockTowerReservation(src,dst))continue;
+  if(!MmGrottoBound(src)||!MmGrottoBound(dst))throw std::invalid_argument("Unsupported generated MM grotto row");
+  value["overrides"].push_back({{"source",src},{"destination",dst}});
+ }
+ MmGrottoLayout proof;proof.install(value);return value;
+}
+inline void ApplyNativeMmGrottos(const NativeFns& native,const nlohmann::json& extension){
+ MmGrottoLayout proof;proof.install(extension);
+ if(!native.applySeed||!native.dumpSeed)throw std::runtime_error("MM grotto seed exports unavailable");
+ const auto* snapshot=native.dumpSeed();if(!snapshot)throw std::runtime_error("MM grotto seed snapshot unavailable");
+ auto current=nlohmann::json::parse(snapshot);current["grottoEntranceExpansion"]=extension;
+ if(!native.applySeed(current.dump().c_str()))throw std::runtime_error("MM grotto seed rejected");
+ const auto* dump=native.dumpSeed();if(!dump)throw std::runtime_error("MM grotto engine roundtrip unavailable");
+ const auto loaded=nlohmann::json::parse(dump);
+ if(!loaded.contains("grottoEntranceExpansion")||loaded.at("grottoEntranceExpansion")!=extension)throw std::runtime_error("MM grotto seed failed actual engine roundtrip");
+}
+class MmGrottoAssumptionScope{
+ NativeFns native;
+public:
+ MmGrottoAssumptionScope(NativeFns f,const Overrides& rows,const Pools& pools,const Settings& settings):native(f){
+  if(!native.setAssumptions||!native.clearAssumptions)throw std::runtime_error("MM grotto assumption exports unavailable");
+  if(!native.setAssumptions(EncodeMmGrottoAssumptions(rows,pools,settings).dump().c_str()))throw std::runtime_error("MM grotto assumptions rejected");
+ }
+ ~MmGrottoAssumptionScope(){native.clearAssumptions();}
+ MmGrottoAssumptionScope(const MmGrottoAssumptionScope&)=delete;
+};
+inline nlohmann::json GenerateNativeMmGrottos(Settings settings,uint32_t seed,const NativeFns& native,
+ const std::string& ootDump,const std::string& mmDump,const std::string& forcedOot,
+ const OracleFns& oot,const OracleFns& mm,bool mmStart,CwGoal goal){
+ if(settings.erGrottos==Mode::None)return nlohmann::json();
+ if(settings.games!=Games::Mm||settings.erGrottos!=Mode::OwnGame||settings.erDecoupled||
+    settings.erBoss!=Mode::None||settings.erDungeons!=Mode::None||settings.erRegions!=Mode::None||
+    settings.erOverworld!=Mode::None||settings.erIndoors!=Mode::None||settings.erMixed!=Mode::None||
+    settings.erWallmasters!=Mode::None||settings.erOneWays!=Mode::None||settings.erWarps!=Warps::None||settings.erSpawns!=Spawns::None)
+  throw std::invalid_argument("MM grotto generator requires the complete coupled default-US own-game pool");
+ NativeScope restore(native);AssumedWorld world(ootDump,mmDump,forcedOot);
+ CwRng rng(CwHashName("entrances:mm-grotto-coupled-v1:"+std::to_string(seed)));
+ Bindings bindings;
+ bindings.areaExists=[](std::string_view area){return MmOrdinaryNativeAreaExists(area)||MmGrottoNativeAreaExists(area);};
+ bindings.sourceSupported=[](const Record& record){return MmGrottoBound(record.name);};
+ bindings.destinationSupported=bindings.sourceSupported;
+ bindings.chooseIndex=[&](size_t count){CheckGenerationCancellation();return rng.below(static_cast<uint32_t>(count));};
+ bindings.validateAssumed=[&](const Overrides& rows,const Pools& pools){
+  MmGrottoAssumptionScope scope(native,rows,pools,settings);
+  return world.validate(oot,mm,mmStart,goal);
+ };
+ bindings.validateComplete=[&](const Overrides& rows){
+  const auto extension=EncodeMmGrottoExtension(rows,settings.erNoPolarity);
+  if(extension.at("overrides").size()!=kMmGrottoGraphBindings.size())throw std::runtime_error("Incomplete default-US MM grotto pool");
+  ApplyNativeMmGrottos(native,extension);return world.validate(oot,mm,mmStart,goal);
+ };
+ const auto rows=Shuffler(settings,std::move(bindings)).run();
+ return EncodeMmGrottoExtension(rows,settings.erNoPolarity);
+}
+}
diff --git a/combo/rando/entrances/MmGrottos.h b/combo/rando/entrances/MmGrottos.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmGrottos.h
@@ -0,0 +1,101 @@
+// Port of pinned OoTMM MM canonical/custom entrance and grotto-exit behavior.
+// Context adapter only: not enabled in the bounded Wallmaster runtime profile.
+#pragma once
+#include "Context.h"
+#include "GrottoMetadata.h"
+#include <algorithm>
+#include <optional>
+
+namespace ComboRando::Entrances {
+enum class MmPreviousScene : uint8_t { Other, TerminaField, GreatBayCoast };
+struct MmGrottoContext {
+    std::array<MmRespawn, 4> respawn;
+    MmPreviousScene previousScene = MmPreviousScene::Other;
+    int32_t respawnFlag = 0;
+    bool snowheadCleared = false;
+    uint8_t data() const { return static_cast<uint8_t>(respawn[3].data); }
+    void setData(uint8_t value) { respawn[3].data = static_cast<int8_t>(value); }
+};
+inline uint32_t NormalizeMmSceneVariant(uint32_t entrance) {
+    uint32_t sceneKey = entrance >> 9;
+    switch (sceneKey) {
+        case 0x06: sceneKey = 0x42; break;
+        case 0x57: sceneKey = 0x4d; break;
+        case 0x45: sceneKey = 0x4a; break;
+        case 0x5b: sceneKey = 0x5a; break;
+        default: break;
+    }
+    return (sceneKey << 9) | (entrance & 0x1ff);
+}
+inline std::optional<Key> CanonicalMmEntrance(uint32_t entrance, const MmGrottoContext& context) {
+    entrance = NormalizeMmSceneVariant(entrance);
+    if (entrance == Find("MM_GROTTO_TYPE_GENERIC")->id) {
+        const auto value = context.data() & 0x1f;
+        const auto it = std::find(kMmGenericGrottoData.begin(), kMmGenericGrottoData.end(), value);
+        if (it == kMmGenericGrottoData.end()) return std::nullopt;
+        return Key{Game::Mm, 0x10000u + static_cast<uint32_t>(it - kMmGenericGrottoData.begin())};
+    }
+    if (entrance == Find("MM_GROTTO_TYPE_COW")->id) {
+        if (context.previousScene == MmPreviousScene::TerminaField) return Key{Game::Mm, Find("MM_GROTTO_COW_FIELD")->id};
+        if (context.previousScene == MmPreviousScene::GreatBayCoast) return Key{Game::Mm, Find("MM_GROTTO_COW_COAST")->id};
+        return std::nullopt;
+    }
+    return Key{Game::Mm, entrance};
+}
+inline Key LogicalMmGrottoExit(uint8_t room, const MmGrottoContext& context) {
+    std::string_view name;
+    switch (room) {
+        case 0x00: name = "MM_GROTTO_EXIT_GOSSIPS_OCEAN"; break;
+        case 0x01: name = "MM_GROTTO_EXIT_GOSSIPS_SWAMP"; break;
+        case 0x02: name = "MM_GROTTO_EXIT_GOSSIPS_CANYON"; break;
+        case 0x03: name = "MM_GROTTO_EXIT_GOSSIPS_MOUNTAIN"; break;
+        case 0x04: {
+            const auto generic = CanonicalMmEntrance(Find("MM_GROTTO_TYPE_GENERIC")->id, context);
+            if (generic) return {Game::Mm, 0x10100u + generic->id - 0x10000u};
+            break;
+        }
+        case 0x07: name = "MM_GROTTO_EXIT_DODONGO"; break;
+        case 0x09: name = "MM_GROTTO_EXIT_SCRUB"; break;
+        case 0x0a:
+            if (context.previousScene == MmPreviousScene::TerminaField) name = "MM_GROTTO_EXIT_COW_FIELD";
+            if (context.previousScene == MmPreviousScene::GreatBayCoast) name = "MM_GROTTO_EXIT_COW_COAST";
+            break;
+        case 0x0b: name = "MM_GROTTO_EXIT_BIO_BABA"; break;
+        case 0x0d: name = "MM_GROTTO_EXIT_PEAHAT"; break;
+        case 0x0e: name = "MM_GROTTO_EXIT_HOT_WATER"; break;
+        default: break;
+    }
+    return {Game::Mm, Find(name.empty() ? "MM_INTERNAL_EXIT_GROTTO" : name)->id};
+}
+inline Key ApplyMmCustomEntrance(Key key, MmGrottoContext& context) {
+    if (key.game != Game::Mm) throw std::invalid_argument("MM adapter received foreign-game destination");
+    if (key.id >= 0x10000 && key.id < 0x10000 + kMmGenericGrottoData.size()) {
+        context.setData(static_cast<uint8_t>((context.data() & ~0x1f) | kMmGenericGrottoData[key.id - 0x10000]));
+        return {Game::Mm, Find("MM_GROTTO_TYPE_GENERIC")->id};
+    }
+    if (key.id == Find("MM_GROTTO_COW_FIELD")->id || key.id == Find("MM_GROTTO_COW_COAST")->id) {
+        context.previousScene = key.id == Find("MM_GROTTO_COW_FIELD")->id ? MmPreviousScene::TerminaField : MmPreviousScene::GreatBayCoast;
+        return {Game::Mm, Find("MM_GROTTO_TYPE_COW")->id};
+    }
+    if (key.id >= 0x10100 && key.id < 0x10100 + kMmGrottoExits.size()) {
+        const auto* exit = &kMmGrottoExits[key.id - 0x10100];
+        if (key.id == Find("MM_GROTTO_EXIT_GENERIC_MOUNTAIN_VILLAGE")->id && !context.snowheadCleared)
+            exit = &kMmGrottoExitMountainWinter;
+        MmRespawn native;
+        native.pos = {static_cast<float>(exit->x), static_cast<float>(exit->y), static_cast<float>(exit->z)};
+        native.entrance = exit->nativeEntrance;
+        native.playerParams = 0x04ff;
+        native.roomIndex = exit->room;
+        // Native MM slots: 3=grotto, 0=void, 2=death. All flags/data/yaw
+        // intentionally zero, exactly as applyGrottoExit in pinned source.
+        context.respawn[3] = native;
+        context.respawn[0] = native;
+        context.respawn[2] = native;
+        context.respawnFlag = 4;
+        return {Game::Mm, native.entrance};
+    }
+    // Remaining MM grotto/grave entries are native entrances already.
+    if (key.id > 0xffffu) throw std::invalid_argument("Unknown extended MM arrival ID");
+    return key;
+}
+} // namespace ComboRando::Entrances
diff --git a/combo/rando/entrances/MmMarkedSourceTransition.h b/combo/rando/entrances/MmMarkedSourceTransition.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmMarkedSourceTransition.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+namespace ComboRando::Entrances {
+// A native source hook marks intent; only completed transitions consume it.
+// Owner/file/unchanged source checks prevent stale scene/save and return lookups.
+class MmMarkedSourceTransition {
+ const void* owner=nullptr;int file=-1;uint16_t source=0;
+public:
+ void clear(){owner=nullptr;file=-1;source=0;}
+ void mark(const void* play,int slot,uint16_t nativeSource){
+  clear();if(!play||slot<0||slot>2)return;
+  owner=play;file=slot;source=nativeSource;
+ }
+ std::optional<uint16_t> take(const void* play,int slot,uint16_t nativeSource){
+  const auto savedOwner=owner;const auto savedFile=file;const auto savedSource=source;
+  clear(); // pinned boolean marker is consumed before any override lookup
+  if(!savedOwner||play!=savedOwner||slot!=savedFile||nativeSource!=savedSource)return std::nullopt;
+  return savedSource;
+ }
+};
+}
diff --git a/combo/rando/entrances/MmMixedGraph.h b/combo/rando/entrances/MmMixedGraph.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmMixedGraph.h
@@ -0,0 +1,35 @@
+#pragma once
+#include "rando/entrances/MmMixedLayout.h"
+#include "rando/entrances/MmGrottoGraph.h"
+namespace ComboRando::Entrances {
+struct MmMixedAssumptions{std::map<uint32_t,std::set<uint32_t>> routes;std::set<uint32_t> syntheticDestinations;};
+inline std::optional<MmMixedAssumptions>& ActiveMmMixedAssumptions(){static thread_local std::optional<MmMixedAssumptions> value;return value;}
+inline MmMixedAssumptions BuildMmMixedAssumptions(const Overrides& rows,const Pools& pools,const Settings& settings){
+ MmMixedAssumptions result;
+ auto source=[&](const Record* a){if(!MmMixedBound(a))throw std::invalid_argument("Unbound MM mixed assumed source");result.routes.try_emplace(MmMixedSourceKey(a->id));for(const auto& alias:kMmOrdinaryBindings)if(alias.name==a->name)result.routes.try_emplace(MmMixedSourceKey(alias.physicalId));};
+ auto bind=[&](const Record* a,const Record* b){source(a);if(!MmMixedBound(b))throw std::invalid_argument("Unbound MM mixed assumed destination");result.routes[MmMixedSourceKey(a->id)].insert(b->id);for(const auto& alias:kMmOrdinaryBindings)if(alias.name==a->name)result.routes[MmMixedSourceKey(alias.physicalId)].insert(b->id);};
+ for(const auto& [src,dst]:rows){if(IsMmGrottoClockTowerReservation(src,dst))continue;bind(Find(src),Find(dst));}
+ for(const auto& pool:pools){
+  const bool synthetic=pool.src.size()*pool.dst.size()>5000&&pool.src.size()>50;
+  for(const auto src:pool.src){const auto* a=Find(src);source(a);if(!synthetic)for(const auto dst:pool.dst){const auto* b=Find(dst);if(!MmMixedBound(b))throw std::invalid_argument("Unbound MM mixed remaining destination");if(Assignable(*a,*b,pool.ownGame,settings))bind(a,b);}}
+  if(synthetic)for(const auto dst:pool.dst){const auto* b=Find(dst);if(!MmMixedBound(b))throw std::invalid_argument("Unbound synthetic MM mixed arrival");result.syntheticDestinations.insert(b->id);}
+ }
+ return result;
+}
+inline bool MmMixedGraphOverrides(uint32_t source){if(const auto& assumed=ActiveMmMixedAssumptions();assumed&&assumed->routes.contains(MmMixedSourceKey(source)))return true;return ActiveMmMixed().containsSource(source);}
+inline std::vector<uint32_t> MmMixedGraphDestinations(uint32_t source){if(const auto& assumed=ActiveMmMixedAssumptions()){auto i=assumed->routes.find(MmMixedSourceKey(source));if(i!=assumed->routes.end())return {i->second.begin(),i->second.end()};}return {ActiveMmMixed().destination(source)};}
+inline nlohmann::json EncodeMmMixedAssumptions(const Overrides& rows,const Pools& pools,const Settings& settings){
+ BuildMmMixedAssumptions(rows,pools,settings);
+ nlohmann::json value={{"schemaVersion",1},{"profile","mm-mixed-coupled-assumptions-v1"},{"upstreamCommit",kUpstreamCommit},{"registrySha256",kRegistrySourceSha256},{"noPolarity",settings.erNoPolarity},{"selfLoops",settings.erSelfLoops},{"overworld",Active(settings.erOverworld)},{"overrides",nlohmann::json::object()},{"remainingPools",nlohmann::json::array()}};
+ for(const auto& [src,dst]:rows)value["overrides"][std::string(src)]=dst;
+ for(const auto& pool:pools)value["remainingPools"].push_back({{"name",pool.name},{"src",pool.src},{"dst",pool.dst},{"ownGame",pool.ownGame},{"alias",pool.alias}});
+ return value;
+}
+inline MmMixedAssumptions DecodeMmMixedAssumptions(const nlohmann::json& value){
+ if(!value.is_object()||value.value("schemaVersion",0)!=1||value.value("profile",std::string())!="mm-mixed-coupled-assumptions-v1"||value.value("upstreamCommit",std::string())!=kUpstreamCommit||value.value("registrySha256",std::string())!=kRegistrySourceSha256||!value.at("noPolarity").is_boolean()||!value.at("selfLoops").is_boolean())throw std::invalid_argument("Invalid MM mixed assumptions");
+ Settings settings;settings.games=Games::Mm;settings.erNoPolarity=value.at("noPolarity");settings.erSelfLoops=value.at("selfLoops");if(value.at("overworld").get<bool>())settings.erOverworld=Mode::OwnGame;Overrides rows;Pools pools;
+ for(const auto& [src,dst]:value.at("overrides").items()){auto a=Find(src),b=Find(dst.get<std::string>());if(!a||!b)throw std::invalid_argument("Unknown MM mixed assumed record");rows[a->name]=b->name;}
+ for(const auto& p:value.at("remainingPools")){Pool pool;pool.name=p.at("name").get<std::string>();pool.ownGame=p.at("ownGame").get<bool>();pool.alias=p.at("alias").get<bool>();for(const auto& v:p.at("src")){auto a=Find(v.get<std::string>());if(!a)throw std::invalid_argument("Unknown mixed source");pool.src.insert(a->name);}for(const auto& v:p.at("dst")){auto a=Find(v.get<std::string>());if(!a)throw std::invalid_argument("Unknown mixed destination");pool.dst.insert(a->name);}pools.push_back(std::move(pool));}
+ return BuildMmMixedAssumptions(rows,pools,settings);
+}
+}
diff --git a/combo/rando/entrances/MmMixedLayout.h b/combo/rando/entrances/MmMixedLayout.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmMixedLayout.h
@@ -0,0 +1,44 @@
+// Coupled same-MM ordinary + full-US grotto identities. MIT; see LICENSE.OoTMM.
+#pragma once
+#include "rando/entrances/MmOrdinaryLayout.h"
+#include "rando/entrances/MmGrottoLayout.h"
+#include "rando/entrances/Shuffle.h"
+namespace ComboRando::Entrances {
+inline bool MmMixedBound(const Record* r){return r&&r->game==Game::Mm&&!r->reverse.empty()&&(MmOrdinaryBound(r->name)||MmGrottoBound(r->name));}
+inline uint32_t MmMixedSourceKey(uint32_t id){return id>0xffffu?id:CanonicalMmOrdinarySource(id);}
+inline bool MmMixedOrdinarySource(uint32_t source){for(const auto& row:kMmOrdinaryBindings)if(MmMixedSourceKey(row.physicalId)==MmMixedSourceKey(source))return true;return false;}
+class MmMixedLayout {
+ std::map<uint32_t,uint32_t> routes; nlohmann::json saved;
+public:
+ void clear(){routes.clear();saved=nlohmann::json();}
+ bool active()const{return !saved.is_null();}
+ bool containsSource(uint32_t source)const{return routes.contains(MmMixedSourceKey(source));}
+ uint32_t destination(uint32_t source)const{auto i=routes.find(MmMixedSourceKey(source));return i==routes.end()?source:i->second;}
+ const nlohmann::json& json()const{return saved;}
+ void install(const nlohmann::json& value){
+  MmMixedLayout next;
+  if(!value.is_object()||value.value("schemaVersion",0)!=1||value.value("profile",std::string())!="mm-mixed-coupled-v1"||value.value("upstreamCommit",std::string())!=kUpstreamCommit||value.value("registrySha256",std::string())!=kRegistrySourceSha256||!value.at("noPolarity").is_boolean()||!value.at("selfLoops").is_boolean()||!value.at("overworld").is_boolean()||!value.at("overrides").is_array())throw std::invalid_argument("Invalid coupled MM mixed envelope");
+  Settings policy;policy.erNoPolarity=value.at("noPolarity");policy.erSelfLoops=value.at("selfLoops");if(value.at("overworld").get<bool>())policy.erOverworld=Mode::OwnGame;
+  std::map<std::string,std::string> named;
+  for(const auto& row:value.at("overrides")){
+   const auto src=row.at("source").get<std::string>(),dst=row.at("destination").get<std::string>();const auto* a=Find(src);const auto* b=Find(dst);
+   if(!MmMixedBound(a)||!MmMixedBound(b))throw std::invalid_argument("Unbound coupled MM mixed route: "+src+" -> "+dst);
+   const auto* ra=Reverse(*a);const auto* rb=Reverse(*b);
+   // Pin tests assignability on the sampled row, then adds its coupled reverse
+   // without re-testing asymmetric self-loop metadata. Either orientation may
+   // have been sampled; requiring both would reject valid generated layouts.
+   if(!MmMixedBound(ra)||!MmMixedBound(rb)||(!Assignable(*a,*b,true,policy)&&!Assignable(*rb,*ra,true,policy)))throw std::invalid_argument("Incompatible coupled MM mixed pair: "+src+" -> "+dst);
+   if(!named.emplace(src,dst).second||!next.routes.emplace(MmMixedSourceKey(a->id),b->id).second)throw std::invalid_argument("Duplicate MM mixed source");
+   for(const auto& alias:kMmOrdinaryBindings)if(alias.name==src){auto [it,ok]=next.routes.emplace(MmMixedSourceKey(alias.physicalId),b->id);if(!ok&&it->second!=b->id)throw std::invalid_argument("Ambiguous MM mixed physical source");}
+  }
+  for(const auto& [src,dst]:named){auto a=Find(src),b=Find(dst);auto reverse=named.find(std::string(b->reverse));if(reverse==named.end()||reverse->second!=a->reverse)throw std::invalid_argument("Uncoupled MM mixed return");}
+  next.saved=value;*this=std::move(next);
+ }
+};
+inline MmMixedLayout& ActiveMmMixed(){static MmMixedLayout value;return value;}
+inline void ValidateMmMixedSeed(const nlohmann::json& seed){
+ if(!seed.contains("mixedEntranceExpansion"))return;
+ if(seed.contains("ordinaryEntranceExpansion")||seed.contains("grottoEntranceExpansion"))throw std::invalid_argument("Conflicting separate and mixed MM entrance layouts");
+ MmMixedLayout proof;proof.install(seed.at("mixedEntranceExpansion"));
+}
+}
diff --git a/combo/rando/entrances/MmMixedNativeArrival.h b/combo/rando/entrances/MmMixedNativeArrival.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmMixedNativeArrival.h
@@ -0,0 +1,22 @@
+#pragma once
+#include "rando/entrances/MmGrottoNative.h"
+#include "rando/entrances/NativeArrival.h"
+namespace ComboRando::Entrances {
+struct MmMixedMarkedSource{uint32_t logicalId;int previousScene;};
+class MmMixedMarkedTransition{
+ const void* owner=nullptr;bool marked=false;int file=-1;uint16_t native=0;MmMixedMarkedSource source{};
+public:
+ bool pending()const{return marked;}
+ void clear(){owner=nullptr;marked=false;file=-1;native=0;source={};}
+ void mark(const void* play,int slot,uint32_t logical,uint16_t expectedNative,int previousScene){clear();marked=true;owner=play;file=slot;native=expectedNative;source={logical,previousScene};}
+ std::optional<MmMixedMarkedSource> take(const void* play,int slot,uint16_t expectedNative){const auto o=owner;const auto f=file;const auto n=native;const auto s=source;clear();if(!o||o!=play||f<0||f>2||f!=slot||n!=expectedNative)return std::nullopt;return s;}
+};
+// Destination preparation is transactional: all fallible typed conversion precedes
+// writes. Source actor collision/respawn setup stays native and is not reinterpreted.
+template<class Native>struct PreparedMmMixedArrival{Native slots[4];MmPreviousScene previous;int32_t flag;int cutscene;uint16_t entrance;};
+template<class Native>PreparedMmMixedArrival<Native> PrepareNativeMmMixedArrival(uint32_t destination,const Native* slots,MmPreviousScene previous,int32_t flag,int cutscene,bool wf,bool sh,bool gb,bool st){
+ PreparedMmMixedArrival<Native> out{};for(size_t i=0;i<4;++i)out.slots[i]=slots[i];out.previous=previous;out.flag=flag;out.cutscene=cutscene;
+ const auto native=ApplyNativeMmGrotto(Key{Game::Mm,destination},out.slots,out.previous,out.flag,sh);
+ const auto fixed=FixMmNativeArrival(native,wf,sh,gb,st,out.cutscene);if(fixed>0xffffu)throw std::invalid_argument("Unrepresentable MM mixed arrival");out.entrance=static_cast<uint16_t>(fixed);return out;
+}
+}
diff --git a/combo/rando/entrances/MmMixedNativeBridge.h b/combo/rando/entrances/MmMixedNativeBridge.h
new file mode 100644
--- /dev/null
+++ b/combo/rando/entrances/MmMixedNativeBridge.h
@@ -0,0 +1,53 @@
+#pragma once
+#include "rando/entrances/NativeBridge.h"
+#include "rando/entrances/MmMixedGraph.h"
+#include "rando/entrances/MmOrdinaryAreas.h"
+#include "rando/entrances/MmOrdinaryGenerationSettings.h"
+namespace ComboRando::Entrances {
+inline Settings MmMixedGenerationSettings(Settings ordinary,bool grottos){
+ ordinary.erMixed=Mode::OwnGame;ordinary.erMixedIndoors=Active(ordinary.erIndoors);ordinary.erMixedOverworld=Active(ordinary.erOverworld);ordinary.erMixedDungeons=Active(ordinary.erDungeons);
+ if(grottos){ordinary.erGrottos=Mode::OwnGame;ordinary.erMixedGrottos=true;}
+ return ordinary;
+}
+inline bool MmMixedAreaExists(std::string_view area){return MmOrdinaryNativeAreaExists(area)||MmGrottoNativeAreaExists(area);}
+inline void ValidateMmMixedGenerationCoverage(const Settings& settings){
+ if(settings.games!=Games::Mm||settings.erDecoupled||settings.erMixed!=Mode::OwnGame||settings.erGrottos!=Mode::OwnGame||!settings.erMixedGrottos||(!settings.erMixedIndoors&&!settings.erMixedOverworld&&!settings.erMixedDungeons)||settings.erBoss!=Mode::None||settings.erWallmasters!=Mode::None||settings.erOneWays!=Mode::None||settings.erWarps!=Warps::None||settings.erSpawns!=Spawns::None)
+  throw std::invalid_argument("MM mixed generator requires coupled MM-only ordinary and grotto pools");
+ Types selected;for(const auto& pool:MakePools(settings)){selected.insert(pool.src.begin(),pool.src.end());selected.insert(pool.dst.begin(),pool.dst.end());}
+ auto require=[](const Record& r){if(!MmMixedBound(&r)||(r.from!="NONE"&&!MmMixedAreaExists(r.from))||(r.to!="NONE"&&!MmMixedAreaExists(r.to)))throw std::invalid_argument("Requested MM mixed pool has no complete native binding: "+std::string(r.name));};
+ for(const auto& record:kRegistry)if(record.game==Game::Mm&&selected.contains(record.type)){
+  // Pin computeAllEntrances excludes JP interiors absent from the selected US
+  // world. These four pairs are conditional on actual area/context availability;
+  // no Default-US record is removed to make a requested pool pass admission.
+  const bool conditionalJp=record.name=="MM_GROTTO_JP_CLIMB_LEFT"||record.name=="MM_GROTTO_JP_CLIMB_RIGHT"||record.name=="MM_GROTTO_JP_LINE_START"||record.name=="MM_GROTTO_JP_LINE_END";
+  if(conditionalJp&&!MmMixedAreaExists(record.to))continue;
+  require(record);if(const auto* reverse=Reverse(record))require(*reverse);
+ }
+}
+inline nlohmann::json EncodeMmMixedExtension(const Overrides& rows,const Settings& settings){
+ nlohmann::json value={{"schemaVersion",1},{"profile","mm-mixed-coupled-v1"},{"upstreamCommit",kUpstreamCommit},{"registrySha256",kRegistrySourceSha256},{"noPolarity",settings.erNoPolarity},{"selfLoops",settings.erSelfLoops},{"overworld",Active(settings.erOverworld)},{"overrides",nlohmann::json::array()}};
+ for(const auto& [src,dst]:rows){if(IsMmGrottoClockTowerReservation(src,dst))continue;value["overrides"].push_back({{"source",src},{"destination",dst}});}
+ MmMixedLayout proof;proof.install(value);return value;
+}
+inline void ApplyNativeMmMixed(const NativeFns& native,const nlohmann::json& extension){
+ MmMixedLayout proof;proof.install(extension);if(!native.applySeed||!native.dumpSeed)throw std::runtime_error("MM mixed seed exports unavailable");
+ const auto* dump=native.dumpSeed();if(!dump)throw std::runtime_error("MM mixed seed snapshot unavailable");
+ auto current=nlohmann::json::parse(dump);current.erase("ordinaryEntranceExpansion");current.erase("grottoEntranceExpansion");current["mixedEntranceExpansion"]=extension;ApplyNativeSeed(native,current);
+}
+class MmMixedAssumptionScope{
+ NativeFns native;
+public:
+ MmMixedAssumptionScope(NativeFns f,const Overrides& rows,const Pools& pools,const Settings& settings):native(f){if(!native.setAssumptions||!native.clearAssumptions)throw std::runtime_error("MM mixed assumption exports unavailable");if(!native.setAssumptions(EncodeMmMixedAssumptions(rows,pools,settings).dump().c_str()))throw std::runtime_error("MM mixed assumptions rejected");}
+ ~MmMixedAssumptionScope(){native.clearAssumptions();}
+ MmMixedAssumptionScope(const MmMixedAssumptionScope&)=delete;
+};
+inline nlohmann::json GenerateNativeMmMixed(Settings settings,uint32_t seed,const NativeFns& native,const std::string& ootDump,const std::string& mmDump,const std::string& forcedOot,const OracleFns& oot,const OracleFns& mm,bool mmStart,CwGoal goal){
+ ValidateMmMixedGenerationCoverage(settings);NativeScope restore(native);AssumedWorld world(ootDump,mmDump,forcedOot);
+ CwRng rng(CwHashName("entrances:mm-mixed-coupled-v1:"+std::to_string(seed)));Bindings bindings;
+ bindings.areaExists=MmMixedAreaExists;bindings.sourceSupported=[](const Record& r){return MmMixedBound(&r);};bindings.destinationSupported=bindings.sourceSupported;
+ bindings.chooseIndex=[&](size_t count){CheckGenerationCancellation();return rng.below(static_cast<uint32_t>(count));};
+ bindings.validateAssumed=[&](const Overrides& rows,const Pools& pools){const auto graph=BuildMmMixedAssumptions(rows,pools,settings);MmMixedAssumptionScope scope(native,rows,pools,settings);return world.validate(oot,mm,mmStart||!graph.syntheticDestinations.empty(),goal);};
+ bindings.validateComplete=[&](const Overrides& rows){ApplyNativeMmMixed(native,EncodeMmMixedExtension(rows,settings));return world.validate(oot,mm,mmStart,goal);};
+ const auto rows=Shuffler(settings,std::move(bindings)).run();return EncodeMmMixedExtension(rows,settings);
+}
+}
