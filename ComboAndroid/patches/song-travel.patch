+extern "C" uint32_t SOH_LiveIncomingSongs() {
+    auto fn=(uint32_t(*)())Combo_ResolveSym("2ship", "MM_GetLiveSongSources");
+    if (!fn) return 0;
+    auto* portal=RegionTable(RR_MARKET_MASK_SHOP);
+    const bool mmAccessible=sMmVisitedForSongs || portal->Child()||portal->Adult() || (ComboRando::ActiveSongTravel().resolve(SOH_GetSongSources()) & 0xffc0);
+    return ComboRando::ActiveSongTravel().resolve((mmAccessible ? fn() : 0) | OotLiveSoaringSources()) & 63;
+}
+extern "C" COMBO_EXPORT int SOH_TakeSongDeparture() { int d=sSongDeparture; sSongDeparture=-1; return d; }
+extern "C" COMBO_EXPORT void SOH_SetSongArrival(int d) { sSongArrival=d>=0 && d<6 ? d : -1; }
+extern "C" int SOH_ConsumeSongArrival() { int d=sSongArrival; sSongArrival=-1; if(d>=0) sMmVisitedForSongs=true; return d<0 ? -1 : ComboRando::kOotSongEntrances[d]; }
+extern "C" int Combo_OOTSongWarp(PlayState* play, int source) {
+    if (!IS_RANDO || !ComboRando::ActiveSongTravel().enabled || source<0 || source>=6) return 0;
+    const int dest=ComboRando::ActiveSongTravel().destination(source);
+    if(dest>=6) { sSongDeparture=dest; play->transitionTrigger=TRANS_TRIGGER_OFF; }
+    else { play->nextEntranceIndex=ComboRando::kOotSongEntrances[dest]; play->transitionTrigger=TRANS_TRIGGER_START;
+        play->transitionType=TRANS_TYPE_FADE_WHITE_FAST; gSaveContext.respawnFlag=0; gSaveContext.cutsceneIndex=0; }
+    return 1;
+}
