+inline void DrawSongTravel() {
+    const char* module=ComboUI::IsMmActive() ? "2ship" : "soh";
+    const char* prefix=ComboUI::IsMmActive() ? "MM_" : "SOH_";
+    auto sym=[&](const char* suffix){ return Combo_ResolveSym(module,(std::string(prefix)+suffix).c_str()); };
+    auto request=(int(*)())sym("ForeignSongRequest");
+    if (!request || request()<0) return;
+    auto choices=(uint32_t(*)())sym("ForeignSongChoices");
+    auto destination=(int(*)(int))sym("ForeignSongDestination");
+    auto choose=(void(*)(int))sym("ForeignSongChoose");
+    auto input=(uint32_t(*)())sym("ForeignSongInput");
+    if(!choices || !choose || !destination) return;
+    std::vector<int> sources;
+    uint32_t mask=choices();
+    for(int i=0;i<16;i++) if(mask & (1u<<i)) sources.push_back(i);
+    static int selected=0, previousRequest=-1, previousGame=-1;
+    static double acceptInputAfter=0;
+    int song=request(), game=ComboUI::GetForegroundGame();
+    if(song!=previousRequest || game!=previousGame || !ImGui::IsPopupOpen("Song travel")) {
+        selected=0; previousRequest=song; previousGame=game;
+        acceptInputAfter=ImGui::GetTime()+0.35; // the final A note is not a confirmation
+        ImGui::OpenPopup("Song travel");
+    }
+    const auto viewport=ImGui::GetMainViewport();
+    ImGui::SetNextWindowPos(viewport->GetCenter(),ImGuiCond_Always,ImVec2(.5f,.5f));
+    ImGui::SetNextWindowSizeConstraints(ImVec2(340,0),ImVec2(viewport->Size.x*.85f,viewport->Size.y*.8f));
+    if(ImGui::BeginPopupModal("Song travel",nullptr,ImGuiWindowFlags_AlwaysAutoResize)) {
+        ImGui::Text("You played %s",song==6 ? "Song of Soaring" : kSongNames[song]);
+        ImGui::Separator();
+        const bool ready=ImGui::GetTime()>=acceptInputAfter;
+        uint32_t pressed=ready && input ? input() : 0;
+        // Menu navigation captures controller input before the game sees it.
+        // Also read ImGui's events so A/B and the D-pad work in either mode.
+        if(ready) {
+            if(ImGui::IsKeyPressed(ImGuiKey_GamepadDpadUp,false) || ImGui::IsKeyPressed(ImGuiKey_UpArrow,false)) pressed|=0x0800;
+            if(ImGui::IsKeyPressed(ImGuiKey_GamepadDpadDown,false) || ImGui::IsKeyPressed(ImGuiKey_DownArrow,false)) pressed|=0x0400;
+            if(ImGui::IsKeyPressed(ImGuiKey_GamepadFaceDown,false) || ImGui::IsKeyPressed(ImGuiKey_Enter,false)) pressed|=0x8000;
+            if(ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight,false) || ImGui::IsKeyPressed(ImGuiKey_Escape,false)) pressed|=0x4000;
+        }
+        ImGui::BeginDisabled(!ready);
+        int count=int(sources.size());
+        if(count) {
+            if(pressed & 0x0800) selected=(selected+count-1)%count;
+            if(pressed & 0x0400) selected=(selected+1)%count;
+            selected=selected<count ? selected : 0;
+            for(int row=0;row<count;row++) {
+                int d=destination(sources[row]);
+                std::string label=std::string(d<6 ? "OoT: " : "MM: ")+kSongLandingNames[d];
+                if(ImGui::Selectable(label.c_str(),selected==row,ImGuiSelectableFlags_DontClosePopups,ImVec2(0,ImGui::GetFrameHeight()*1.4f))) selected=row;
+            }
+            if(ImGui::Button("Warp (A)",ImVec2(155,ImGui::GetFrameHeight()*1.5f)) || (pressed & 0x8000)) {
+                choose(sources[selected]); ImGui::CloseCurrentPopup();
+            }
+            ImGui::SameLine();
+        } else ImGui::TextWrapped("No available destinations.");
+        if(ImGui::Button("Cancel (B)",ImVec2(155,ImGui::GetFrameHeight()*1.5f)) || (pressed & 0x4000)) {
+            choose(-1); ImGui::CloseCurrentPopup();
+        }
+        ImGui::EndDisabled();
+        ImGui::EndPopup();
+    }
+}
