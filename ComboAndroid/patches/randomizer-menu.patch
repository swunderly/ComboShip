+// One catalog defines ordering, page explanations and search aliases for both engines.
+struct RandomizerPageInfo { const char* name; const char* help; const char* keywords; };
+inline constexpr RandomizerPageInfo kRandomizerPages[] = {
+    {"Generate", "Create a combined seed after choosing the options below.", "seed generation goals shared items starting world"},
+    {"Items & checks", "Choose which locations give randomized rewards and which extra items can be found.", "check pool item pool shuffles shops merchants scenery drops abilities upgrades souls songs plentiful"},
+    {"Starting inventory", "Choose the items and resources you begin a new seed with.", "starting items equipment hearts consumables"},
+    {"Logic & access", "Choose the logic and requirements for reaching areas and bosses.", "world rules conditions entrances requirements"},
+    {"Dungeons", "Configure dungeon items, key placement and game-specific dungeon rules.", "small keys boss keys keyrings maps compass fairies master quest"},
+    {"Hints & traps", "Choose how hints work and which disguised traps enter the seed.", "gossip stone hints ice traps junk"},
+    {"Excluded checks", "Choose individual locations that should not hold progression items.", "locations check exclusions excluded checks"},
+    {"Tricks & glitches", "Choose the optional techniques the logic may expect you to use.", "tricks glitches difficulty"},
+    {"Plandomizer", "Place specific items in a combined seed.", "planned placements plando"},
+};
+inline int RandomizerPageOrder(const std::string& page) {
+    for (int i = 0; i < int(sizeof(kRandomizerPages) / sizeof(kRandomizerPages[0])); ++i)
+        if (page == kRandomizerPages[i].name) return i;
+    return 100; // Retain unknown upstream pages after the known workflow.
+}
+inline const char* RandomizerPageHelp(const std::string& page) {
+    for (const auto& info : kRandomizerPages) if (page == info.name) return info.help;
+    return "Configure this world's options for the next combined seed.";
+}
+// A widget belongs to exactly one subpage. Indices/callbacks remain those of the native menu.
+inline int RandomizerWidgetGroup(bool oot, const std::string& sidebar, int column,
+                                 const std::string& heading) {
+    if (oot && sidebar == "Shuffles") return column < 2 ? 0 : 1;
+    if (!oot && sidebar == "Check Pool") return 0;
+    if (!oot && sidebar == "Item Pool") return 1;
+    if (oot && sidebar == "Hints/Traps") return heading == "Traps" ? 1 : 0;
+    if (!oot && sidebar == "Hints") return 0;
+    if (!oot && sidebar == "Traps") return 1;
+    return -1;
+}
 } // namespace ComboRando
