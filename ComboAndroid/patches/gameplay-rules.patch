+++ b/combo/rando/GameplayRules.h
@@ -0,0 +1,48 @@
+#pragma once
+#include <algorithm>
+#include <nlohmann/json.hpp>
+
+namespace ComboRando {
+// Explicit, versioned allowlist: loading a seed never imports arbitrary CVars or visual preferences.
+// Only add a rule after auditing its runtime/default and documenting its current logic coverage.
+struct GameplayRule { const char* name; const char* label; int fallback; int maximum; const char* help; };
+inline constexpr GameplayRule kGameplayRules[] = {
+    {"gEnhancements.TimeTravel", "Song of Time age change (OoT)", 0, 4,
+     "Changes age at your current position, away from other song interactions. Requires Song of Time and the selected equipment. Logic support: Bottom of the Well route; other new age-change routes are not yet required by generation."},
+    {"gEnhancements.Masks.FierceDeitysAnywhere", "Fierce Deity anywhere (MM)", 0, 1,
+     "Allows the mask outside boss rooms. Logic counts its sword when this is enabled and you own the mask. Boss-room use remains available without this setting. Extra jumps and other movement shortcuts are not yet required by logic."},
+    {"gEnhancements.Masks.BremenOneChick", "Bremen Mask: one chick (MM)", 0, 1,
+     "Recruit one chick while marching to complete Grog's flock. The randomizer still requires the Bremen Mask and access to the Cucco Shack."},
+};
+
+template<class Read> nlohmann::json CaptureGameplayRules(Read read) {
+    nlohmann::json values = nlohmann::json::object();
+    for (const auto& rule : kGameplayRules)
+        values[rule.name] = std::clamp(int(read(rule.name, rule.fallback)), 0, rule.maximum);
+    return {{"version", 1}, {"values", values}};
+}
+template<class Write> void ApplyGameplayRules(const nlohmann::json& rules, Write write) {
+    if (!rules.is_object() || !rules.contains("version") || rules["version"] != 1 ||
+        !rules.contains("values") || !rules["values"].is_object()) return;
+    for (const auto& rule : kGameplayRules) {
+        const auto it = rules["values"].find(rule.name);
+        if (it == rules["values"].end() || !it->is_number_integer()) continue;
+        // Reject out-of-range values before narrowing; malformed imports cannot wrap into valid rules.
+        if (*it < 0 || *it > rule.maximum) continue;
+        write(rule.name, it->get<int>());
+    }
+}
+
+// Matches TimeTravelType and the gameplay hook's equipment checks. Callers separately enforce
+// whether the local scene/position supports playing Song of Time without another song interaction.
+inline bool CanChangeAgeWithSong(int mode, bool canPlaySong, bool hasOot, bool hasMasterSword) {
+    if (!canPlaySong) return false;
+    switch (mode) {
+        case 1: return hasOot;
+        case 2: return hasOot && hasMasterSword;
+        case 3: return true;
+        case 4: return hasMasterSword;
+        default: return false;
+    }
+}
+}
