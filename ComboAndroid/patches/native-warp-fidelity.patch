+Vec3f* CWWarp_Vec3fAddVecSph(Vec3f* dst, Vec3f* vec, VecGeo* sph) {
+    Vec3f result;
+    Vec3f sphVec;
+
+    sphVec = OLib_VecGeoToVec3f(sph);
+    result.x = vec->x + sphVec.x;
+    result.y = vec->y + sphVec.y;
+    result.z = vec->z + sphVec.z;
