+    {"Minimap", "gCosmetics.HUD.Minimap", 250, 0, 1, false, 0, 180},
+    {"Start button", "gCosmetics.HUD.StartButton", 136, 26, .75f, true, 0, -9.75f},
+    {"Horse carrots", "gCosmetics.HUD.Carrots", 160, 64, 1, false},
