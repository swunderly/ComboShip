// Use the native quest page's slots and already-loaded vanilla song textures.
auto startingSong = [&](RandomizerSettingKey key, QuestItem song) {
    const auto& option = settings->GetOption(key);
    const auto entry = std::find_if(vanillaSongMapping.begin(), vanillaSongMapping.end(),
                                  [song](const auto& value) { return value.id == song; });
    data["startingLayout"].push_back({{"key", option.GetCVarName()}, {"label", option.GetName()},
        {"category", "Songs"}, {"kind", "StartingSongToggle"}, {"song", true},
        {"songSlot", int(song) - int(QUEST_SONG_MINUET)},
        {"tiers", nlohmann::json::array({{{"texture", entry->name}, {"faded", entry->nameFaded}}})}});
};
