# ComboShip: compile pinned binary files into the native libraries as C++ byte arrays.
#
# combo_embed_binaries(<output-dir> <name> <namespace> <symbol> <file> <sha256> [<symbol> <file> <sha256> ...])
#
# Each file's SHA-256 must equal its pin, or the configuration stops with FATAL_ERROR. A changed,
# truncated or line-ending-converted copy therefore never builds. The function then writes
# <output-dir>/<name>.h, which declares `const std::uint8_t <symbol>[<size>]` and
# `const std::size_t <symbol>Size` in <namespace>, and <output-dir>/<name>.cpp, which defines them.
# A generated file is rewritten only when its content changes, and every input is a configure
# dependency. Works in script mode (cmake -P) as well.

function(_combo_embed_write_if_changed path content)
    if(EXISTS "${path}")
        file(READ "${path}" previous)
        if(previous STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

function(combo_embed_binaries output_dir name namespace)
    set(entries ${ARGN})
    list(LENGTH entries count)
    math(EXPR remainder "${count} % 3")
    if(count EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "combo_embed_binaries(${name}): expected <symbol> <file> <sha256> triples")
    endif()
    set(banner "// Generated by CMake/ComboEmbedBinary.cmake. Do not edit.\n")
    set(header "${banner}#pragma once\n\n#include <cstddef>\n#include <cstdint>\n\nnamespace ${namespace} {\n")
    set(source "${banner}#include \"${name}.h\"\n\nnamespace ${namespace} {\n")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last} 3)
        math(EXPR file_index "${index} + 1")
        math(EXPR hash_index "${index} + 2")
        list(GET entries ${index} symbol)
        list(GET entries ${file_index} file)
        list(GET entries ${hash_index} expected)
        if(NOT EXISTS "${file}")
            message(FATAL_ERROR "combo_embed_binaries(${name}): ${file} is missing")
        endif()
        file(SHA256 "${file}" actual)
        string(TOLOWER "${expected}" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "combo_embed_binaries(${name}): SHA-256 mismatch for ${file}\n"
                                "  pinned ${expected}\n  actual ${actual}")
        endif()
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" digits)
        math(EXPR size "${digits} / 2")
        if(size EQUAL 0)
            message(FATAL_ERROR "combo_embed_binaries(${name}): ${file} is empty")
        endif()
        # Sixteen bytes per line.
        string(REPEAT "[0-9a-f]" 32 line_pattern)
        string(REGEX REPLACE "(${line_pattern})" "\\1\n" lines "${hex}")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${lines}")
        string(STRIP "${bytes}" bytes)
        string(REPLACE "\n" "\n    " bytes "${bytes}")
        get_filename_component(file_name "${file}" NAME)
        string(APPEND header "extern const std::uint8_t ${symbol}[${size}];\nextern const std::size_t ${symbol}Size;\n")
        string(APPEND source "\n// ${file_name}: ${size} bytes, sha256 ${actual}\n"
                             "const std::uint8_t ${symbol}[${size}] = {\n    ${bytes}\n};\n"
                             "const std::size_t ${symbol}Size = sizeof(${symbol});\n")
        if(NOT CMAKE_SCRIPT_MODE_FILE)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        endif()
    endforeach()
    string(APPEND header "} // namespace ${namespace}\n")
    string(APPEND source "} // namespace ${namespace}\n")
    file(MAKE_DIRECTORY "${output_dir}")
    _combo_embed_write_if_changed("${output_dir}/${name}.h" "${header}")
    _combo_embed_write_if_changed("${output_dir}/${name}.cpp" "${source}")
endfunction()
